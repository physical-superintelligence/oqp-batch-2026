theorem certificateDescendantSteps2_decreasing :
    ∀ i p g, certificateDescendantSteps2 i = .inr (p, g) → p < i := by
  have hbound : ∀ i : Fin 729, match certificateDescendantSteps2 i with
    | .inl _ => True
    | .inr pg => pg.1 < i := by
    intro i
    fin_cases i <;> simp [certificateDescendantSteps2]
  intro i p g he
  have h := hbound i
  simpa only [he] using h

/-- Every literal physical column is a finite word of the signed lowering
operators applied to an original source-bound highest frame column. -/
theorem certificateDescendantColumns2_generated (i : Fin 729) :
    ∃ s : Fin 51, ∃ word : List (Fin 2),
      certificateSparseVector (certificateDescendantColumns2 i) =
        word.foldl (fun x g => certificateLocalLowering {0} g *ᵥ x)
          (certificateSparseVector (certificateDescendantSeeds2 s)) :=
  certificateDescendantProgram_sound (certificateLocalLowering {0})
    (fun i => certificateSparseVector (certificateDescendantColumns2 i))
    (fun s => certificateSparseVector (certificateDescendantSeeds2 s))
    certificateDescendantSteps2 certificateDescendantSteps2_sound
    certificateDescendantSteps2_decreasing i

