theorem certificateDescendantSteps1_decreasing :
    ∀ i p g, certificateDescendantSteps1 i = .inr (p, g) → p < i := by
  have hbound : ∀ i : Fin 729, match certificateDescendantSteps1 i with
    | .inl _ => True
    | .inr pg => pg.1 < i := by
    intro i
    fin_cases i <;> simp [certificateDescendantSteps1]
  intro i p g he
  have h := hbound i
  simpa only [he] using h

/-- Every literal physical column is a finite word of the signed lowering
operators applied to an original source-bound highest frame column. -/
theorem certificateDescendantColumns1_generated (i : Fin 729) :
    ∃ s : Fin 51, ∃ word : List (Fin 2),
      certificateSparseVector (certificateDescendantColumns1 i) =
        word.foldl (fun x g => certificateLocalLowering {0, 1, 2} g *ᵥ x)
          (certificateSparseVector (certificateDescendantSeeds1 s)) :=
  certificateDescendantProgram_sound (certificateLocalLowering {0, 1, 2})
    (fun i => certificateSparseVector (certificateDescendantColumns1 i))
    (fun s => certificateSparseVector (certificateDescendantSeeds1 s))
    certificateDescendantSteps1 certificateDescendantSteps1_sound
    certificateDescendantSteps1_decreasing i

