/-!
# Exact sparse local frames from the endpoint certificate archive
Only definitions are exported. No Gram identity, highest-weight equation,
independence, completeness or certificate correctness is asserted here.
Each source NPY blob was decoded independently and checked against SHA256.
Rows are literal six-digit base-three words in the archive's lexical order.
The support contains 1852 signs; the declared Gram tables contain 1539 integers.
-/

namespace ThreeCopyQutritWerner

/-- Evaluate a finite list of signed matrix entries, adding any repeated entries. -/
def certificateMatrixFromSparseEntries {m : ℕ}
    (entries : List ((Fin 6 → Fin 3) × Fin m × ℤ)) :
    Matrix (Fin 6 → Fin 3) (Fin m) ℤ :=
  fun w j => (entries.map (fun e => if e.1 = w ∧ e.2.1 = j then e.2.2 else 0)).sum


