      (5, 5, 8), (5, 5, 9), (5, 6, 7), (5, 6, 8), (5, 6, 9), (5, 7, 8), (5, 7, 9), (5, 8, 9), (6, 0, 1), (6, 0, 2), (6, 0, 3), (6, 0, 4),
      (6, 0, 5), (6, 0, 6), (6, 0, 7), (6, 0, 8), (6, 0, 9), (6, 0, 10), (6, 1, 2), (6, 1, 3), (6, 1, 4), (6, 1, 5), (6, 1, 6), (6, 1, 7),
      (6, 1, 8), (6, 1, 9), (6, 1, 10), (6, 2, 3), (6, 2, 4), (6, 2, 5), (6, 2, 6), (6, 2, 7), (6, 2, 8), (6, 2, 9), (6, 2, 10), (6, 3, 4),
      (6, 3, 5), (6, 3, 6), (6, 3, 7), (6, 3, 8), (6, 3, 9), (6, 3, 10), (6, 4, 5), (6, 4, 6), (6, 4, 7), (6, 4, 8), (6, 4, 9), (6, 4, 10),
      (6, 5, 6), (6, 5, 7), (6, 5, 8), (6, 5, 9), (6, 5, 10), (6, 6, 7), (6, 6, 8), (6, 6, 9), (6, 6, 10), (6, 7, 8), (6, 7, 9), (6, 7, 10),
      (6, 8, 9), (6, 8, 10), (6, 9, 10)]]

/-! ## Blocks -/

/-- Number of blocks of each sector. -/
def x2NumKeys : Fin 3 → ℕ := ![122, 169, 123]

/-- Offset of each sector in the global block order. -/
def x2KeyOffset : Fin 3 → ℕ := ![0, 122, 291]

/-- The blocks of sector `s`. -/
abbrev x2Key (s : Fin 3) := Fin (x2NumKeys s)

/-- Global index of a block (position in the certificate's image list). -/
def x2KeyGlobal (s : Fin 3) (b : x2Key s) : Fin 414 :=
  ⟨(x2KeyOffset s + b.val) % 414, Nat.mod_lt _ (by norm_num)⟩

/-- Sorted local types of a block. -/
def x2KeyTypes (s : Fin 3) (b : x2Key s) : Fin 3 → Fin 8 := x2GlobalTypes (x2KeyGlobal s b)

/-- Stabilizer kind of a block. -/
def x2KeyKind (s : Fin 3) (b : x2Key s) : ℕ := x2GlobalKind (x2KeyGlobal s b)

/-- S3 degree of a block (1, or 2 for the standard kind). -/
def x2KeyDegree (s : Fin 3) (b : x2Key s) : ℕ := x2GlobalDegree (x2KeyGlobal s b)

/-- Size `r_b` of a block. -/
def x2KeySize (s : Fin 3) (b : x2Key s) : ℕ := x2GlobalSize (x2KeyGlobal s b)

/-- Local multiplicity of the `i`-th site of a block. -/
abbrev x2KeyMult (s : Fin 3) (b : x2Key s) (i : Fin 3) : ℕ := x2Mult s (x2KeyTypes s b i)

/-- Ambient coordinates of a block: the three local multiplicity spaces. -/
abbrev x2Amb (s : Fin 3) (b : x2Key s) :=
  Fin (x2KeyMult s b 0) × Fin (x2KeyMult s b 1) × Fin (x2KeyMult s b 2)

/-- Image (column) coordinates of a block. -/
abbrev x2Col (s : Fin 3) (b : x2Key s) := Fin (x2KeySize s b)

/-- Distinct site arrangements of a type triple (`6 / |stabilizer|`). -/
def x2Orbit (t : Fin 3 → Fin 8) : ℕ :=
  if t 0 = t 1 ∧ t 1 = t 2 then 1 else if t 0 = t 1 ∨ t 1 = t 2 ∨ t 0 = t 2 then 3 else 6

/-- Multiplicity weight `ν_b = degree · ∏ d_{tᵢ} · orbit` of a block. -/
def x2Weight (s : Fin 3) (b : x2Key s) : ℕ :=
  x2KeyDegree s b * (x2IrrepDim s (x2KeyTypes s b 0) * x2IrrepDim s (x2KeyTypes s b 1) *
    x2IrrepDim s (x2KeyTypes s b 2)) * x2Orbit (x2KeyTypes s b)

/-! ## Local matrices -/

/-- Local Gram matrix `G_{s,t}`. -/
def x2Gram (s : Fin 3) (t : Fin 8) : Matrix (Fin (x2Mult s t)) (Fin (x2Mult s t)) ℤ :=
  Matrix.of fun i j => ((x2GramRows s t).getD i.val []).getD j.val 0

/-- Sector-0 Q-form `D_t = U_{0,t}ᵀ (Ω₀₅ ⊗ I) U_{0,t}` of the target's pairing. -/
def x2SwapDiagram (t : Fin 8) : Matrix (Fin (x2Mult 0 t)) (Fin (x2Mult 0 t)) ℤ :=
  Matrix.of fun i j => ((x2SwapRows t).getD i.val []).getD j.val 0

/-- Three-site metric `G_{t₀} ⊗ G_{t₁} ⊗ G_{t₂}` of a block's ambient. -/
def x2GramKron (s : Fin 3) (b : x2Key s) : Matrix (x2Amb s b) (x2Amb s b) ℤ :=
  x2Gram s (x2KeyTypes s b 0) ⊗ₖ (x2Gram s (x2KeyTypes s b 1) ⊗ₖ x2Gram s (x2KeyTypes s b 2))

/-- Local target `G_t - D_t / 2` (the Q-form of `I - Ω₀₅ / 2`). -/
def x2LocalTarget (t : Fin 8) : Matrix (Fin (x2Mult 0 t)) (Fin (x2Mult 0 t)) ℚ :=
  (x2Gram 0 t).map (Int.cast : ℤ → ℚ) - (1 / 2 : ℚ) • (x2SwapDiagram t).map (Int.cast : ℤ → ℚ)

/-! ## Data and inputs -/

/-- Flat (row-major) index of an ambient coordinate. -/
def x2FlatIndex {p q r : ℕ} (x : Fin p × Fin q × Fin r) : ℕ :=
  ((x.1 : ℕ) * q + x.2.1) * r + x.2.2

theorem x2FlatIndex_lt {p q r : ℕ} (x : Fin p × Fin q × Fin r) :
    x2FlatIndex x < p * q * r := by
  obtain ⟨⟨a, ha⟩, ⟨b, hb⟩, ⟨c, hc⟩⟩ := x
  show (a * q + b) * r + c < p * q * r
  have h1 : a * q + b + 1 ≤ p * q := by
    calc a * q + b + 1 ≤ a * q + q := by omega
      _ = (a + 1) * q := by ring
      _ ≤ p * q := Nat.mul_le_mul_right q (Nat.succ_le_of_lt ha)
  calc (a * q + b) * r + c < (a * q + b) * r + r := by omega
    _ = (a * q + b + 1) * r := by ring
    _ ≤ p * q * r := Nat.mul_le_mul_right r h1

/-- An image matrix from the certificate's flat `n × r` array (`n = m₀ m₁ m₂`, row-major). -/
def x2ImageOfFlat {p q r k : ℕ} (J : Matrix (Fin (p * q * r)) (Fin k) ℤ) :
    Matrix (Fin p × Fin q × Fin r) (Fin k) ℤ :=
  Matrix.of fun x c => J ⟨x2FlatIndex x, x2FlatIndex_lt x⟩ c

/-- The large data of the reduced statement.
* `image s b` is the exact integer image `J_b` of the certificate, reshaped by `x2ImageOfFlat`;
* `transS s`, `transA s` (for `s = 1, 2`) are the diagonal blocks of the exact rational
  `N₀ R_s⁻¹ Niₛ` (`R_s = R{s}_numerator / R{s}_denominator`, parity maps of the certificate); the
  entries for `s = 0` play no role. -/
structure X2Data where
  image : (s : Fin 3) → (b : x2Key s) → Matrix (x2Amb s b) (x2Col s b) ℤ
  transS : Fin 3 → Matrix (Fin 282) (Fin 282) ℚ
  transA : Fin 3 → Matrix (Fin 231) (Fin 231) ℚ

/-- Block matrices of one sector, in image coordinates. -/
abbrev X2Blocks (s : Fin 3) := ∀ b : x2Key s, Matrix (x2Col s b) (x2Col s b) ℚ

/-- Block metric `H_b = J_bᵀ (G ⊗ G ⊗ G) J_b`. -/
def x2Metric (D : X2Data) (s : Fin 3) (b : x2Key s) : Matrix (x2Col s b) (x2Col s b) ℤ :=
  (D.image s b)ᵀ * x2GramKron s b * D.image s b

/-! ## The reduced transfer of a source sector -/

/-- Total lookup of a three-site column matrix at natural coordinates (zero outside). -/
def x2Get3 {p q r : ℕ} {ι : Type*} (V : Matrix (Fin p × Fin q × Fin r) ι ℚ) (i j k : ℕ)
    (c : ι) : ℚ :=
  if h : i < p ∧ j < q ∧ k < r then V (⟨i, h.1⟩, ⟨j, h.2.1⟩, ⟨k, h.2.2⟩) c else 0

/-- Total lookup of a three-site square matrix at natural coordinates (zero outside). -/
def x2Lookup {p q r : ℕ} (M : Matrix (Fin p × Fin q × Fin r) (Fin p × Fin q × Fin r) ℚ)
    (a b : Fin 3 → ℕ) : ℚ :=
  if h : (a 0 < p ∧ a 1 < q ∧ a 2 < r) ∧ (b 0 < p ∧ b 1 < q ∧ b 2 < r) then
    M (⟨a 0, h.1.1⟩, ⟨a 1, h.1.2.1⟩, ⟨a 2, h.1.2.2⟩) (⟨b 0, h.2.1⟩, ⟨b 1, h.2.2.1⟩, ⟨b 2, h.2.2.2⟩)
  else 0

/-- Standard-copy partner: `(P V)(x, y, z) = V(z, x, y) - V(y, z, x)` (the certificate's `a.transpose(1,2,0,3) - a.transpose(2,0,1,3)`; used only when the three types are equal). -/
def x2Partner {p q r : ℕ} {ι : Type*} (V : Matrix (Fin p × Fin q × Fin r) ι ℚ) :
    Matrix (Fin p × Fin q × Fin r) ι ℚ :=
  Matrix.of fun x c => x2Get3 V x.2.2 x.1 x.2.1 c - x2Get3 V x.2.1 x.2.2 x.1 c

/-- Local Q-form of the invariant extension of one source block on its canonical arrangement:
`GJ N GJᵀ`, plus `(1/3) (P GJ) N (P GJ)ᵀ` for S3 degree 2. -/
def x2InputBlock (D : X2Data) (s : Fin 3) (N : X2Blocks s) (b : x2Key s) :
    Matrix (x2Amb s b) (x2Amb s b) ℚ :=
  let GJ : Matrix (x2Amb s b) (x2Col s b) ℚ :=
    (x2GramKron s b * D.image s b).map (Int.cast : ℤ → ℚ)
  GJ * N b * GJᵀ +
    if x2KeyDegree s b = 2 then (1 / 3 : ℚ) • (x2Partner GJ * N b * (x2Partner GJ)ᵀ) else 0

/-- The six permutations of three sites, as index maps. -/
def x2Perm3 : Fin 6 → Fin 3 → Fin 3 :=
  ![![0, 1, 2], ![0, 2, 1], ![1, 0, 2], ![1, 2, 0], ![2, 0, 1], ![2, 1, 0]]

/-- Number of site permutations `σ` with `t ∘ σ = τ` (the stabilizer order of `τ` when `t` is a
rearrangement of `τ`, else `0`). -/
def x2ArrangeCount (t τ : Fin 3 → Fin 8) : ℕ :=
  (Finset.univ.filter (fun p : Fin 6 => t ∘ x2Perm3 p = τ)).card

/-- The three-site local Q-form of the source operator at an arbitrary type arrangement `t` and
local unit coordinates `(aᵢ, bᵢ)`: the canonical block of the sorted arrangement, read through
every site permutation `σ` with `t ∘ σ = τ` and averaged over them. (For the certificate data
the canonical blocks are stabilizer invariant, so every such `σ` gives the same value and this is
the certificate's single-representative `embed`; the average makes the operator S3-invariant for any data.) -/
def x2FullTensor (D : X2Data) (s : Fin 3) (N : X2Blocks s) (t : Fin 3 → Fin 8)
    (a b : Fin 3 → ℕ) : ℚ :=
  ∑ k : x2Key s, ∑ p : Fin 6,
    if t ∘ x2Perm3 p = x2KeyTypes s k then
      ((x2ArrangeCount t (x2KeyTypes s k) : ℚ))⁻¹ *
        x2Lookup (x2InputBlock D s N k) (a ∘ x2Perm3 p) (b ∘ x2Perm3 p)
    else 0

/-- Symmetric parity select of one site: `f a a`, or `(f a b + f b a) / 2`. -/
def x2SelS (f : ℕ → ℕ → ℚ) (a b : ℕ) : ℚ := if a = b then f a a else (f a b + f b a) / 2

/-- Antisymmetric parity select of one site: `(f a b - f b a) / 2`. -/
def x2SelA (f : ℕ → ℕ → ℚ) (a b : ℕ) : ℚ := (f a b - f b a) / 2

/-- Source tensor `S` (symmetric parity at all three sites). -/
def x2EmbedS (D : X2Data) (s : Fin 3) (N : X2Blocks s) (l₀ l₁ l₂ : Fin 282) : ℚ :=
  let u₀ := x2SLabel s l₀
  let u₁ := x2SLabel s l₁
  let u₂ := x2SLabel s l₂
  x2SelS (fun x₀ y₀ => x2SelS (fun x₁ y₁ => x2SelS (fun x₂ y₂ =>
      x2FullTensor D s N ![u₀.1, u₁.1, u₂.1] ![x₀, x₁, x₂] ![y₀, y₁, y₂])
      u₂.2.1 u₂.2.2) u₁.2.1 u₁.2.2) u₀.2.1 u₀.2.2

/-- Source tensor `A` (symmetric parity at the first site, antisymmetric at the other two). -/
def x2EmbedA (D : X2Data) (s : Fin 3) (N : X2Blocks s) (l₀ : Fin 282) (l₁ l₂ : Fin 231) : ℚ :=
  let u₀ := x2SLabel s l₀
  let u₁ := x2ALabel s l₁
  let u₂ := x2ALabel s l₂
  x2SelS (fun x₀ y₀ => x2SelA (fun x₁ y₁ => x2SelA (fun x₂ y₂ =>
      x2FullTensor D s N ![u₀.1, u₁.1, u₂.1] ![x₀, x₁, x₂] ![y₀, y₁, y₂])
      u₂.2.1 u₂.2.2) u₁.2.1 u₁.2.2) u₀.2.1 u₀.2.2

/-- Contraction of the first tensor axis with a matrix. -/
def x2Axis0 {ι κ β γ : Type*} [Fintype κ] (M : Matrix ι κ ℚ) (T : κ → β → γ → ℚ) :
    ι → β → γ → ℚ :=
  fun i j k => ∑ a, M i a * T a j k

/-- Contraction of the second tensor axis with a matrix. -/
def x2Axis1 {ι κ α γ : Type*} [Fintype κ] (M : Matrix ι κ ℚ) (T : α → κ → γ → ℚ) :
    α → ι → γ → ℚ :=
  fun i j k => ∑ b, M j b * T i b k

/-- Contraction of the third tensor axis with a matrix. -/
def x2Axis2 {ι κ α β : Type*} [Fintype κ] (M : Matrix ι κ ℚ) (T : α → β → κ → ℚ) :
    α → β → ι → ℚ :=
  fun i j k => ∑ c, M k c * T i j c

/-- Transferred symmetric tensor `(Rs ⊗ Rs ⊗ Rs) S` (axis 2, then 1, then 0, as computed). -/
def x2TransferS (D : X2Data) (s : Fin 3) (N : X2Blocks s) : Fin 282 → Fin 282 → Fin 282 → ℚ :=
  x2Axis0 (D.transS s) (x2Axis1 (D.transS s) (x2Axis2 (D.transS s) (x2EmbedS D s N)))

/-- Transferred mixed-parity tensor `(Rs ⊗ Ra ⊗ Ra) A`. -/
def x2TransferA (D : X2Data) (s : Fin 3) (N : X2Blocks s) : Fin 282 → Fin 231 → Fin 231 → ℚ :=
  x2Axis0 (D.transS s) (x2Axis1 (D.transA s) (x2Axis2 (D.transA s) (x2EmbedA D s N)))

/-- S-label of the unordered pair `{a, b}` of type `t`. -/
def x2SIdx (s : Fin 3) (t : Fin 8) (a b : ℕ) : Fin 282 :=
  ⟨(x2SOff s t + (min a b * x2Mult s t - min a b * (min a b - 1) / 2) + (max a b - min a b)) % 282,
    Nat.mod_lt _ (by norm_num)⟩

/-- A-label of the pair `(min a b, max a b)` of type `t` (meaningful for `a ≠ b`). -/
def x2AIdx (s : Fin 3) (t : Fin 8) (a b : ℕ) : Fin 231 :=
  ⟨(x2AOff s t + (min a b * x2Mult s t - min a b * (min a b + 1) / 2) +
      (max a b - min a b - 1)) % 231, Nat.mod_lt _ (by norm_num)⟩

/-- Orientation sign of a pair: `1` if `a < b`, `-1` if `b < a`, `0` on the diagonal. -/
def x2Sgn (a b : ℕ) : ℚ := if a < b then 1 else if b < a then -1 else 0

/-- Reading a sector-0 Q-form on the ambient of an h-block from its parity tensors: the
symmetric part plus the three placements of the mixed part (the certificate's `raw`). -/
def x2RawH (Sh : Fin 282 → Fin 282 → Fin 282 → ℚ) (Ah : Fin 282 → Fin 231 → Fin 231 → ℚ)
    (b : x2Key 0) : Matrix (x2Amb 0 b) (x2Amb 0 b) ℚ :=
  Matrix.of fun x y =>
    let t := x2KeyTypes 0 b
    let xs : Fin 3 → ℕ := ![x.1, x.2.1, x.2.2]
    let ys : Fin 3 → ℕ := ![y.1, y.2.1, y.2.2]
    let l : Fin 3 → Fin 282 := fun i => x2SIdx 0 (t i) (xs i) (ys i)
    let m : Fin 3 → Fin 231 := fun i => x2AIdx 0 (t i) (xs i) (ys i)
    let e : Fin 3 → ℚ := fun i => x2Sgn (xs i) (ys i)
    Sh (l 0) (l 1) (l 2) + e 1 * e 2 * Ah (l 0) (m 1) (m 2) +
      e 0 * e 2 * Ah (l 1) (m 0) (m 2) + e 0 * e 1 * Ah (l 2) (m 0) (m 1)

/-- REDUCED TRANSFER: the Q-form, on h-block `b`, of `Γ(G_s)` for the source sector `s`
(`Γ = Γ₃₄` for `s = 1`, `Γ₁₂₃₄` for `s = 2`), where `G_s` is the invariant extension of the
source blocks `N`. Equals `output_s / output_denominator_s` of the certificate's archive for the trial. -/
def x2Out (D : X2Data) (s : Fin 3) (N : X2Blocks s) (b : x2Key 0) :
    Matrix (x2Col 0 b) (x2Col 0 b) ℚ :=
  let J : Matrix (x2Amb 0 b) (x2Col 0 b) ℚ := (D.image 0 b).map (Int.cast : ℤ → ℚ)
  Jᵀ * x2RawH (x2TransferS D s N) (x2TransferA D s N) b * J

/-! ## Target, residual and the reduced bridge statement -/

/-- Target Q-form `T_b = J_bᵀ (⊗ᵢ (G_{tᵢ} - D_{tᵢ}/2)) J_b` of `Π T Π` on h-block `b`. -/
def x2Target (D : X2Data) (b : x2Key 0) : Matrix (x2Col 0 b) (x2Col 0 b) ℚ :=
  let J : Matrix (x2Amb 0 b) (x2Col 0 b) ℚ := (D.image 0 b).map (Int.cast : ℤ → ℚ)
  let T : Matrix (x2Amb 0 b) (x2Amb 0 b) ℚ := x2LocalTarget (x2KeyTypes 0 b 0) ⊗ₖ
    (x2LocalTarget (x2KeyTypes 0 b 1) ⊗ₖ x2LocalTarget (x2KeyTypes 0 b 2))
  Jᵀ * T * J

/-- RESIDUAL BLOCKS `Nh` (Q-form): `T_b - out^m_b(Nm) - out^a_b(Na)`. -/
def x2Residual (D : X2Data) (Nm : X2Blocks 1) (Na : X2Blocks 2) (b : x2Key 0) :
    Matrix (x2Col 0 b) (x2Col 0 b) ℚ :=
  x2Target D b - x2Out D 1 Nm b - x2Out D 2 Na b

/-- Complex form of a rational block. -/
def x2Complex {n : Type*} (M : Matrix n n ℚ) : Matrix n n ℂ := M.map (fun q : ℚ => (q : ℂ))

/-- The reduced bridge: for the certificate data `D`, positive semidefinite source blocks and positive
semidefinite residual blocks prove T2.1a. The bridge modules (`CertificateX2Bridge*`) prove it from the site
and key facts; the proof builds the lifts `W` of
`qutritEndpointInequality_of_block_residual` (frames, images `J`, S3 kinds, irrep copies),
shows `hbridge` from the reduced identities `W_bᵀ (Π T Π - Π Γ₃₄(Gm) Π - Π Γ₁₂₃₄(Ga) Π) W_b =
x2Residual D Nm Na b`, and uses completeness of the blocks. -/
def X2ReducedBridge (D : X2Data) : Prop :=
  ∀ (Nm : X2Blocks 1) (Na : X2Blocks 2),
    (∀ b, (x2Complex (Nm b)).PosSemidef) →
    (∀ b, (x2Complex (Na b)).PosSemidef) →
    (∀ b, (x2Complex (x2Residual D Nm Na b)).PosSemidef) →
    QutritEndpointInequality

end ThreeCopyQutritWerner

end
