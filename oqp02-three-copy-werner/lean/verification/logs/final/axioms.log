    C * C = κ • C →
      (ThreeCopyQutritWerner.frobSq C -
              2 * √((ThreeCopyQutritWerner.frobSq C ^ 2 - ThreeCopyQutritWerner.frobSq (C.conjTranspose * C)) / 2)) /
            6 ≤
          ThreeCopyQutritWerner.endpointEnergy C ∧
        (ThreeCopyQutritWerner.endpointEnergy C = 0 →
          (ThreeCopyQutritWerner.ptrace₂₃ (C * C.conjTranspose)).rank ≤ 2 ∧
              (ThreeCopyQutritWerner.ptrace₂₃ (C.conjTranspose * C)).rank ≤ 2 ∨
            (ThreeCopyQutritWerner.ptrace₁₃ (C * C.conjTranspose)).rank ≤ 2 ∧
                (ThreeCopyQutritWerner.ptrace₁₃ (C.conjTranspose * C)).rank ≤ 2 ∨
              (ThreeCopyQutritWerner.ptrace₁₂ (C * C.conjTranspose)).rank ≤ 2 ∧
                (ThreeCopyQutritWerner.ptrace₁₂ (C.conjTranspose * C)).rank ≤ 2)
