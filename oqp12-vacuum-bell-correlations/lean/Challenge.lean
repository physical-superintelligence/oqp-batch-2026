module

public import Mathlib

@[expose] public section

/-!
# Open Quantum Problem 12: Bell inequalities for long range vacuum correlations

This file is the statement of record. It imports only Mathlib. The definitions it uses are copied
verbatim (same names, same bodies, same order and context) from `VacuumBellSeparation/FreeField/Defs.lean`,
between the `-- verbatim:` markers; `scripts/check-challenge-definitions.py` checks the copy. Comparator
checks that `Solution.lean` proves exactly these theorems, using only the axioms `propext`,
`Quot.sound` and `Classical.choice`.

## The problem

Problem 12 of the IQOQI Vienna Open Quantum Problems
(https://oqp.iqoqi.oeaw.ac.at/bell-inequalities-for-long-range-vacuum-correlations), as quoted
verbatim in the paper of record, which cites this address and the Internet Archive copy of the
page of 29 October 2023
(https://web.archive.org/web/20231029013530/https://oqp.iqoqi.oeaw.ac.at/bell-inequalities-for-long-range-vacuum-correlations):

> It is well known [1] that vacuum fluctuations maximally violate the CHSH-Bell inequalities for
> suitable spacelike separated observables, and that this violation goes to zero as the two
> localization regions are moved apart.
>
> Decide whether some (necessarily small) violation of the inequalities is possible for regions
> arbitrarily far apart. For definiteness, consider a massive scalar free relativistic Bose field.

Reference [1] of the problem is S. J. Summers and R. F. Werner (1985).

## The answer stated here: no CHSH violation for bounded regions far enough apart

* `OQP12.no_chsh_violation_far_apart` (headline): for every mass `m > 0`, any two bounded regions
  `O₁, O₂` and any spacelike vector `a`, there is `T₀` (depending on `m`, `O₁`, `O₂`, `a`) such that
  for every `t ≥ T₀` the vacuum satisfies the CHSH inequality
  `|⟨Ω, (A₀(B₀ + B₁) + A₁(B₀ - B₁)) Ω⟩| ≤ 2` for all self-adjoint contractions `A₀, A₁` localized in
  `O₁` and `B₀, B₁` localized in `O₂ + t a`. This is the negation of "a violation persists for
  separations `t` that tend to infinity". It is Corollary 1.2 of the paper in CHSH form.
* `OQP12.theorem_1_1`: Theorem 1.1 of the paper (double cones of radius `R` centred at the origin
  and at `(0, L𝐞₁)`, with `L ≥ C_* R` and one constant `C_*` for all masses and radii).
* `OQP12.corollary_1_2`: Corollary 1.2 of the paper (fixed bounded regions, fixed spacelike
  direction), in the Summers–Werner normalization `β = 1`.
* `OQP12.freeFieldVacuum_exists`: non-vacuity; a vacuum Weyl system exists for every mass `m > 0`.
* `OQP12.no_chsh_violation_far_apart_uniform`: one threshold `D` for all spatial translations `𝐱`
  of the second region with `|𝐱| ≥ D`, in every direction.
* `OQP12.localAlgebra_open_nonabelian`: sanity check; the local algebra of every nonempty open
  region contains two operators that do not commute, so the local algebra of every region with
  nonempty interior, in particular of every double cone of positive radius, is noncommutative.

The model is the real scalar field in 3+1 dimensions.

## How to read the statements

* `Spacetime` is `ℝ × ℝ³` with points `(x⁰, 𝐱)`; `doubleCone a R = {x : |x⁰ - a⁰| + |𝐱 - 𝐚| < R}`.
* `FreeFieldVacuum m H` is a vacuum Weyl system of the free field of mass `m` in the Hilbert space
  `H`: unitary Weyl operators `W(F)` of real smooth compactly supported test functions `F`, with
  the Weyl relations of the one-particle inner product `oneParticleInner m`, a unit vacuum vector
  `Ω` with `⟨Ω, W(F) Ω⟩ = exp(-‖κ_m F‖²/2)`, and `Ω` cyclic. Such systems are unique up to unitary
  equivalence (the Fock vacuum is one), and `freeFieldVacuum_exists` proves that one exists. Every
  theorem below holds for all of them.
* `localAlgebra V O` is the von Neumann algebra generated by the Weyl operators `W(F)` of test
  functions `F` supported in `O`.
* Observables are self-adjoint operators of norm at most `1`. In `theorem_1_1` and `corollary_1_2`
  the Summers–Werner Bell correlation of the vacuum is written out: it is the supremum of the CHSH
  values `½ |⟨Ω, (A₀(B₀ + B₁) + A₁(B₀ - B₁)) Ω⟩|` over observables `A₀, A₁` of the first region and
  `B₀, B₁` of the second. Its classical bound is `1` (a CHSH value of `2`) and, for commuting
  algebras, Tsirelson's bound is `√2`, so `β = 1` means that no choice of local observables violates the CHSH inequality.
-/

section FreeFieldDefinitions

open scoped InnerProductSpace ComplexConjugate ComplexOrder

namespace VacuumBellSeparation

-- verbatim: VacuumBellSeparation/FreeField/Defs.lean
/-- Minkowski spacetime `ℝ^{1+3}`; a point is `(x⁰, 𝐱)`. -/
abbrev Spacetime : Type := ℝ × EuclideanSpace ℝ (Fin 3)

/-- Real smooth compactly supported functions on spacetime. -/
def RealTestFunction : Type :=
  {F : Spacetime → ℝ // ContDiff ℝ (⊤ : ℕ∞) F ∧ HasCompactSupport F}

instance : Add RealTestFunction where
  add F G := ⟨F.1 + G.1, F.2.1.add G.2.1, F.2.2.add G.2.2⟩

/-- The relativistic energy `ω_m(𝐩) = √(m² + |𝐩|²)`. -/
noncomputable def dispersion (m : ℝ) (p : EuclideanSpace ℝ (Fin 3)) : ℝ :=
  Real.sqrt (m ^ 2 + ‖p‖ ^ 2)

/-- The one-particle wave function `(κ_m F)(𝐩) = ∫ e^{i(ω_m(𝐩) x⁰ - 𝐩·𝐱)} F(x) d⁴x`. -/
noncomputable def oneParticle (m : ℝ) (F : RealTestFunction)
    (p : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  ∫ x : Spacetime,
    Complex.exp (Complex.I * ((dispersion m p * x.1 - ⟪p, x.2⟫_ℝ : ℝ) : ℂ)) * (F.1 x : ℂ)

/-- The one-particle inner product `⟨κ_m F, κ_m G⟩ = ∫ conj(κ_m F) κ_m G d𝔪_m` with the
Lorentz-invariant measure `d𝔪_m = d³p / (2(2π)³ ω_m(𝐩))`. -/
noncomputable def oneParticleInner (m : ℝ) (F G : RealTestFunction) : ℂ :=
  ∫ p : EuclideanSpace ℝ (Fin 3), conj (oneParticle m F p) * oneParticle m G p *
    ((1 / (2 * (2 * Real.pi) ^ 3 * dispersion m p) : ℝ) : ℂ)

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- A vacuum Weyl system of the real free scalar field of mass `m` in the Hilbert space `H`. -/
structure FreeFieldVacuum (m : ℝ) (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  /-- The Weyl operators `W(F) = e^{iφ(F)}` of real spacetime test functions. -/
  weyl : RealTestFunction → (H →L[ℂ] H)
  /-- The vacuum vector `Ω`. -/
  vacuum : H
  /-- Each Weyl operator is unitary. -/
  weyl_mem_unitary : ∀ F, weyl F ∈ unitary (H →L[ℂ] H)
  /-- The Weyl relations `W(F)W(G) = e^{-i Im⟨κF, κG⟩} W(F + G)`. -/
  weyl_mul : ∀ F G, weyl F * weyl G =
    Complex.exp (-(Complex.I * ((oneParticleInner m F G).im : ℂ))) • weyl (F + G)
  /-- The vacuum vector is a unit vector. -/
  vacuum_norm : ‖vacuum‖ = 1
  /-- The vacuum is the centred quasi-free state: `⟨Ω, W(F)Ω⟩ = e^{-‖κF‖²/2}`. -/
  vacuum_weyl : ∀ F, ⟪vacuum, weyl F vacuum⟫_ℂ =
    ((Real.exp (-((oneParticleInner m F F).re / 2)) : ℝ) : ℂ)
  /-- The vacuum is cyclic for the Weyl operators. -/
  cyclic : (Submodule.span ℂ (Set.range fun F => weyl F vacuum)).topologicalClosure = ⊤

/-- The commutant `S'` of a set `S` of bounded operators, as a von Neumann algebra (it is the
commutant of `S ∪ S*`). -/
noncomputable def commutantOf (S : Set (H →L[ℂ] H)) : VonNeumannAlgebra H where
  toStarSubalgebra := StarSubalgebra.centralizer ℂ S
  centralizer_centralizer' := by simp

/-- The von Neumann algebra `(S ∪ S*)''` generated by a set `S` of bounded operators. -/
noncomputable def generatedVNA (S : Set (H →L[ℂ] H)) : VonNeumannAlgebra H :=
  (commutantOf S).commutant

/-- The local von Neumann algebra `𝔄_m(O)` generated by the Weyl operators of real test
functions supported in `O`. -/
noncomputable def localAlgebra {m : ℝ} (V : FreeFieldVacuum m H) (O : Set Spacetime) :
    VonNeumannAlgebra H :=
  generatedVNA {T | ∃ F : RealTestFunction, tsupport F.1 ⊆ O ∧ T = V.weyl F}

/-- The double cone `D_R + a = {x : |x⁰ - a⁰| + |𝐱 - 𝐚| < R}`. -/
def doubleCone (a : Spacetime) (R : ℝ) : Set Spacetime :=
  {x | |x.1 - a.1| + ‖x.2 - a.2‖ < R}

/-- The first spatial unit vector `𝐞₁`. -/
noncomputable def e₁ : EuclideanSpace ℝ (Fin 3) := EuclideanSpace.single 0 1
-- end verbatim

end VacuumBellSeparation

end FreeFieldDefinitions

open scoped InnerProductSpace

namespace VacuumBellSeparation.OQP12

/-- **Open Quantum Problem 12 for bounded regions moved apart along a spacelike direction: no CHSH
violation.**

The problem asks: "Decide whether some (necessarily small) violation of the inequalities is
possible for regions arbitrarily far apart. For definiteness, consider a massive scalar free
relativistic Bose field."

For every mass `m > 0`, any two bounded regions `O₁, O₂` of Minkowski space and any spacelike
vector `a`, there is `T₀` such that for every `t ≥ T₀`, in every vacuum Weyl system `V` of the
free field of mass `m` (vacuum vector `Ω`), every choice of self-adjoint contractions
`A₀, A₁ ∈ 𝔄(O₁)` and `B₀, B₁ ∈ 𝔄(O₂ + t a)` satisfies the CHSH inequality
`|⟨Ω, (A₀(B₀ + B₁) + A₁(B₀ - B₁)) Ω⟩| ≤ 2`. -/
theorem no_chsh_violation_far_apart (m : ℝ) (hm : 0 < m)
    (O₁ O₂ : Set Spacetime) (hO₁ : Bornology.IsBounded O₁) (hO₂ : Bornology.IsBounded O₂)
    (a : Spacetime) (ha : a.1 ^ 2 < ‖a.2‖ ^ 2) :
    ∃ T₀ : ℝ, ∀ t : ℝ, T₀ ≤ t →
      ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
        (V : FreeFieldVacuum m H) (A₀ A₁ B₀ B₁ : H →L[ℂ] H),
        A₀ ∈ localAlgebra V O₁ → A₁ ∈ localAlgebra V O₁ →
        B₀ ∈ localAlgebra V ((fun x => x + t • a) '' O₂) →
        B₁ ∈ localAlgebra V ((fun x => x + t • a) '' O₂) →
        IsSelfAdjoint A₀ → IsSelfAdjoint A₁ → IsSelfAdjoint B₀ → IsSelfAdjoint B₁ →
        ‖A₀‖ ≤ 1 → ‖A₁‖ ≤ 1 → ‖B₀‖ ≤ 1 → ‖B₁‖ ≤ 1 →
        ‖⟪V.vacuum, (A₀ * (B₀ + B₁) + A₁ * (B₀ - B₁)) V.vacuum⟫_ℂ‖ ≤ 2 := by
  sorry

/-- **Theorem 1.1 of the paper (separation threshold).** There is a finite constant `C_* > 2`,
independent of `m` and `R`, such that for all `m, R > 0` and `L ≥ C_* R` the vacuum Bell
correlation `β_m(R, L)` of `𝔄_m(D_R)` and `𝔄_m(D_R + (0, L𝐞₁))` equals `1`. Here
`β_m(R, L) = sup ½ |⟨Ω, (A₀(B₀ + B₁) + A₁(B₀ - B₁)) Ω⟩|`, the supremum over self-adjoint
contractions `A₀, A₁ ∈ 𝔄_m(D_R)` and `B₀, B₁ ∈ 𝔄_m(D_R + (0, L𝐞₁))`. -/
theorem theorem_1_1 :
    ∃ Cstar : ℝ, 2 < Cstar ∧
      ∀ m R L : ℝ, 0 < m → 0 < R → Cstar * R ≤ L →
        ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
          (V : FreeFieldVacuum m H),
          sSup {v : ℝ | ∃ A₀ A₁ B₀ B₁ : H →L[ℂ] H,
            A₀ ∈ localAlgebra V (doubleCone 0 R) ∧ A₁ ∈ localAlgebra V (doubleCone 0 R) ∧
            B₀ ∈ localAlgebra V (doubleCone (0, L • e₁) R) ∧
            B₁ ∈ localAlgebra V (doubleCone (0, L • e₁) R) ∧
            IsSelfAdjoint A₀ ∧ IsSelfAdjoint A₁ ∧ IsSelfAdjoint B₀ ∧ IsSelfAdjoint B₁ ∧
            ‖A₀‖ ≤ 1 ∧ ‖A₁‖ ≤ 1 ∧ ‖B₀‖ ≤ 1 ∧ ‖B₁‖ ≤ 1 ∧
            v = (1 / 2 : ℝ) * ‖⟪V.vacuum, (A₀ * (B₀ + B₁) + A₁ * (B₀ - B₁)) V.vacuum⟫_ℂ‖} = 1 := by
  sorry

/-- **Corollary 1.2 of the paper (fixed bounded regions).** For every `m > 0`, any two fixed
bounded regions `O₁, O₂` and any fixed spacelike vector `a`, the vacuum Bell correlation of
`𝔄_m(O₁)` and `𝔄_m(O₂ + t a)` (the supremum of the CHSH values, as in `theorem_1_1`) equals `1` for
all sufficiently large `t`. -/
theorem corollary_1_2 :
    ∀ m : ℝ, 0 < m → ∀ O₁ O₂ : Set Spacetime, Bornology.IsBounded O₁ → Bornology.IsBounded O₂ →
      ∀ a : Spacetime, a.1 ^ 2 < ‖a.2‖ ^ 2 →
        ∃ T₀ : ℝ, ∀ t : ℝ, T₀ ≤ t →
          ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
            (V : FreeFieldVacuum m H),
            sSup {v : ℝ | ∃ A₀ A₁ B₀ B₁ : H →L[ℂ] H,
              A₀ ∈ localAlgebra V O₁ ∧ A₁ ∈ localAlgebra V O₁ ∧
              B₀ ∈ localAlgebra V ((fun x => x + t • a) '' O₂) ∧
              B₁ ∈ localAlgebra V ((fun x => x + t • a) '' O₂) ∧
              IsSelfAdjoint A₀ ∧ IsSelfAdjoint A₁ ∧ IsSelfAdjoint B₀ ∧ IsSelfAdjoint B₁ ∧
              ‖A₀‖ ≤ 1 ∧ ‖A₁‖ ≤ 1 ∧ ‖B₀‖ ≤ 1 ∧ ‖B₁‖ ≤ 1 ∧
              v = (1 / 2 : ℝ) * ‖⟪V.vacuum, (A₀ * (B₀ + B₁) + A₁ * (B₀ - B₁)) V.vacuum⟫_ℂ‖} =
              1 := by
  sorry

/-- **Non-vacuity.** For every mass `m > 0` a vacuum Weyl system of the free field exists, so the
theorems in this file, which quantify over all such systems, are not vacuous. -/
theorem freeFieldVacuum_exists :
    ∀ m : ℝ, 0 < m → ∃ (H : Type) (_ : NormedAddCommGroup H) (_ : InnerProductSpace ℂ H)
      (_ : CompleteSpace H), Nonempty (FreeFieldVacuum m H) := by
  sorry

/-- **No CHSH violation far apart, uniformly over spatial directions.** For every mass `m > 0`
and any two bounded regions `O₁, O₂` there is `D` such that, for every spatial vector `𝐱` with
`|𝐱| ≥ D` (in any direction), in every vacuum Weyl system of mass `m`, all self-adjoint
contractions `A₀, A₁ ∈ 𝔄(O₁)` and `B₀, B₁ ∈ 𝔄(O₂ + (0, 𝐱))` satisfy the CHSH inequality
`|⟨Ω, (A₀(B₀ + B₁) + A₁(B₀ - B₁)) Ω⟩| ≤ 2`. -/
theorem no_chsh_violation_far_apart_uniform (m : ℝ) (hm : 0 < m)
    (O₁ O₂ : Set Spacetime) (hO₁ : Bornology.IsBounded O₁) (hO₂ : Bornology.IsBounded O₂) :
    ∃ D : ℝ, ∀ x : EuclideanSpace ℝ (Fin 3), D ≤ ‖x‖ →
      ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
        (V : FreeFieldVacuum m H) (A₀ A₁ B₀ B₁ : H →L[ℂ] H),
        A₀ ∈ localAlgebra V O₁ → A₁ ∈ localAlgebra V O₁ →
        B₀ ∈ localAlgebra V ((fun y => y + ((0 : ℝ), x)) '' O₂) →
        B₁ ∈ localAlgebra V ((fun y => y + ((0 : ℝ), x)) '' O₂) →
        IsSelfAdjoint A₀ → IsSelfAdjoint A₁ → IsSelfAdjoint B₀ → IsSelfAdjoint B₁ →
        ‖A₀‖ ≤ 1 → ‖A₁‖ ≤ 1 → ‖B₀‖ ≤ 1 → ‖B₁‖ ≤ 1 →
        ‖⟪V.vacuum, (A₀ * (B₀ + B₁) + A₁ * (B₀ - B₁)) V.vacuum⟫_ℂ‖ ≤ 2 := by
  sorry

/-- **Sanity check: the local algebras are noncommutative.** For every mass `m > 0`, in every
vacuum Weyl system, the local algebra of every nonempty open region `O` contains two operators
that do not commute. (If one of two local algebras were commutative, every state would satisfy
the CHSH inequality for that pair; for regions with nonempty interior this rules out such a trivial
reason for the theorems above.) -/
theorem localAlgebra_open_nonabelian (m : ℝ) (hm : 0 < m)
    (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (V : FreeFieldVacuum m H) (O : Set Spacetime) (hO : IsOpen O) (hne : O.Nonempty) :
    ∃ A ∈ localAlgebra V O, ∃ B ∈ localAlgebra V O, A * B ≠ B * A := by
  sorry

end VacuumBellSeparation.OQP12
