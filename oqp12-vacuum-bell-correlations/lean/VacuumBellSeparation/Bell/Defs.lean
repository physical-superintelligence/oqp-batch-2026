module

public import Mathlib

@[expose] public section


/-!
# Bell correlation of a state on two commuting von Neumann algebras

Definitions for Section 2.1 (equation `eq:beta`, (2.4)) of the manuscript
"The vacuum Bell correlation of the massive free scalar field attains the
classical bound for bounded regions beyond a finite separation" (the version of record named in `paper/README.md`).

* `State H` : a state on `B(H)`, i.e. a unital positive complex-linear functional.
* `saContractions M`, `effects M`, `projections M` : the self-adjoint contractions,
  effects (`0 ≤ E ≤ 1`) and projections of a von Neumann algebra `M`.
* `chshOp` : the CHSH combination `A₀(B₀ + B₁) + A₁(B₀ - B₁)`.
* `bellCorrelation ω 𝔄 𝔅` : the Summers–Werner Bell correlation
  `β(ω; 𝔄, 𝔅) = sup ½ |ω(A₀(B₀ + B₁) + A₁(B₀ - B₁))|`, the supremum over self-adjoint
  contractions `Aᵢ ∈ 𝔄`, `Bⱼ ∈ 𝔅`.  The normalization has classical bound `1` and
  Tsirelson bound `√2`.

The manuscript's states are states "on the von Neumann algebra generated by two commuting
von Neumann algebras"; here a state is a functional on all of `B(H)`.  (The vacuum state of
the manuscript is a vector state on `B(H)`.)  This module contains definitions only.
-/

namespace VacuumBellSeparation

/-- A state on `B(H)`: a complex-linear functional `ω` on the bounded operators with
`ω(1) = 1` and `ω(T) ≥ 0` for every positive operator `T`. -/
structure State (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  /-- The underlying complex-linear functional. -/
  toLinearMap : (H →L[ℂ] H) →ₗ[ℂ] ℂ
  /-- Normalization: `ω(1) = 1`. -/
  map_one' : toLinearMap 1 = 1
  /-- Positivity: `ω(T)` is real and nonnegative for every positive operator `T`. -/
  map_nonneg' : ∀ T : H →L[ℂ] H, T.IsPositive →
    (toLinearMap T).im = 0 ∧ 0 ≤ (toLinearMap T).re

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

instance : CoeFun (State H) (fun _ => (H →L[ℂ] H) → ℂ) :=
  ⟨fun ω => ω.toLinearMap⟩

/-- The self-adjoint contractions of a von Neumann algebra `M`. -/
def saContractions (M : VonNeumannAlgebra H) : Set (H →L[ℂ] H) :=
  {A | A ∈ M ∧ IsSelfAdjoint A ∧ ‖A‖ ≤ 1}

/-- The effects of a von Neumann algebra `M`: operators `E ∈ M` with `0 ≤ E ≤ 1`. -/
def effects (M : VonNeumannAlgebra H) : Set (H →L[ℂ] H) :=
  {E | E ∈ M ∧ E.IsPositive ∧ (1 - E).IsPositive}

/-- The (orthogonal) projections of a von Neumann algebra `M`. -/
def projections (M : VonNeumannAlgebra H) : Set (H →L[ℂ] H) :=
  {E | E ∈ M ∧ IsSelfAdjoint E ∧ E * E = E}

/-- Two von Neumann algebras commute elementwise. -/
def Commuting (𝔄 𝔅 : VonNeumannAlgebra H) : Prop :=
  ∀ A ∈ 𝔄, ∀ B ∈ 𝔅, A * B = B * A

/-- The CHSH combination `A₀(B₀ + B₁) + A₁(B₀ - B₁)`. -/
def chshOp (A₀ A₁ B₀ B₁ : H →L[ℂ] H) : H →L[ℂ] H :=
  A₀ * (B₀ + B₁) + A₁ * (B₀ - B₁)

/-- The set of CHSH values `½ |ω(A₀(B₀ + B₁) + A₁(B₀ - B₁))|` over all self-adjoint
contractions `A₀, A₁ ∈ 𝔄` and `B₀, B₁ ∈ 𝔅`. -/
def chshValues (ω : State H) (𝔄 𝔅 : VonNeumannAlgebra H) : Set ℝ :=
  {x | ∃ A₀ ∈ saContractions 𝔄, ∃ A₁ ∈ saContractions 𝔄,
       ∃ B₀ ∈ saContractions 𝔅, ∃ B₁ ∈ saContractions 𝔅,
       x = (1 / 2 : ℝ) * ‖ω (chshOp A₀ A₁ B₀ B₁)‖}

/-- The Summers–Werner Bell correlation `β(ω; 𝔄, 𝔅)` of equation (2.4): the supremum of
the CHSH values, normalized so that the classical bound is `1`. -/
noncomputable def bellCorrelation (ω : State H) (𝔄 𝔅 : VonNeumannAlgebra H) : ℝ :=
  sSup (chshValues ω 𝔄 𝔅)

end VacuumBellSeparation
