module

public import VacuumBellSeparation.Bell.Defs

@[expose] public section


/-!
# Extension of states to the ambient operator algebra

The manuscript allows a state on the algebra generated by the two local algebras,
whereas `State H` is a functional on all bounded operators. The complex Hahn–Banach
theorem extends a functional with its norm unchanged. For a positive functional on
a unital C⋆-algebra the norm is its value at one; conversely, that identity implies
positivity. Thus every positive unital functional on a closed unital star subalgebra
extends to an ambient state, agreeing on every element of the subalgebra.

This is an extension of general states. No normality of the extension is asserted
or needed by the probability criterion.
-/

open scoped ComplexOrder

namespace VacuumBellSeparation

/-- A positive unital functional on a closed unital star subalgebra extends to a
positive unital functional on the ambient C⋆-algebra. -/
theorem exists_positive_unital_extension {A : Type*} [CStarAlgebra A]
    [PartialOrder A] [StarOrderedRing A]
    (S : StarSubalgebra ℂ A) [IsClosed (S : Set A)]
    (f : S →P[ℂ] ℂ) (hf : f 1 = 1) :
    ∃ g : A →P[ℂ] ℂ, g 1 = 1 ∧ ∀ x : S, g x = f x := by
  obtain ⟨g, hg, hnorm⟩ :=
    exists_extension_norm_eq S.toSubalgebra.toSubmodule f.toContinuousLinearMap
  have hg1 : g 1 = 1 := (hg (1 : S)).trans hf
  have hgpos : Monotone g := by
    apply ContinuousLinearMap.monotone_iff_opNorm_eq_map_one.mpr
    calc
      (‖g‖ : ℂ) = (‖f.toContinuousLinearMap‖ : ℂ) := congrArg Complex.ofReal hnorm
      _ = f 1 := f.ofReal_opNorm_eq_map_one
      _ = g 1 := hf.trans hg1.symm
  exact ⟨{ toContinuousLinearMap := g, monotone' := hgpos }, hg1, hg⟩

/-- Continuity need not be assumed separately: positive linear functionals on
C⋆-algebras are automatically continuous. -/
theorem exists_positive_unital_extension_linear {A : Type*} [CStarAlgebra A]
    [PartialOrder A] [StarOrderedRing A]
    (S : StarSubalgebra ℂ A) [IsClosed (S : Set A)]
    (f : S →ₚ[ℂ] ℂ) (hf : f 1 = 1) :
    ∃ g : A →P[ℂ] ℂ, g 1 = 1 ∧ ∀ x : S, g x = f x :=
  exists_positive_unital_extension S (PositiveContinuousLinearMap.ofClass f) hf

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- An ambient positive unital functional gives precisely the `State` used in
the Bell-correlation definitions. -/
def State.ofPositiveContinuousLinearMap (g : (H →L[ℂ] H) →P[ℂ] ℂ)
    (hg : g 1 = 1) : State H where
  toLinearMap := g.toLinearMap
  map_one' := hg
  map_nonneg' T hT := by
    have h := Complex.nonneg_iff.mp
      (g.map_nonneg (ContinuousLinearMap.nonneg_iff_isPositive.mpr hT))
    exact ⟨h.2.symm, h.1⟩

/-- Any state on a closed unital star subalgebra of bounded operators has an
extension of the type used by the probability criterion. -/
theorem exists_state_extension (S : StarSubalgebra ℂ (H →L[ℂ] H))
    [IsClosed (S : Set (H →L[ℂ] H))] (f : S →ₚ[ℂ] ℂ) (hf : f 1 = 1) :
    ∃ ω : State H, ∀ x : S, ω x = f x := by
  obtain ⟨g, hg1, hg⟩ := exists_positive_unital_extension_linear S f hf
  exact ⟨State.ofPositiveContinuousLinearMap g hg1, hg⟩

/-- Von Neumann algebras are norm closed since they are double commutants. -/
theorem isClosed_vonNeumannAlgebra (M : VonNeumannAlgebra H) :
    IsClosed (M : Set (H →L[ℂ] H)) := by
  rw [← M.centralizer_centralizer]
  exact Set.isClosed_centralizer _

/-- In particular, every state on a von Neumann algebra extends to `B(H)`.
This applies to the algebra containing the two local algebras of Theorem 3.1. -/
theorem exists_state_extension_vonNeumann (M : VonNeumannAlgebra H)
    (f : M.toStarSubalgebra →ₚ[ℂ] ℂ) (hf : f 1 = 1) :
    ∃ ω : State H, ∀ x : M.toStarSubalgebra, ω x = f x := by
  letI : IsClosed (M.toStarSubalgebra : Set (H →L[ℂ] H)) :=
    isClosed_vonNeumannAlgebra M
  exact exists_state_extension M.toStarSubalgebra f hf

end VacuumBellSeparation
