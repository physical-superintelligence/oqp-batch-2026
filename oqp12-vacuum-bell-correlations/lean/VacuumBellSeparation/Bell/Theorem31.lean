module

public import VacuumBellSeparation.Bell.EventConstants
public import VacuumBellSeparation.Bell.SpectralThreshold
public import VacuumBellSeparation.Bell.ReflectionApprox

@[expose] public section


/-!
# Theorem 3.1: a probability criterion for the classical CHSH bound

`probability_criterion` is Theorem 3.1 (`thm:probability`) of the manuscript in its stated
form: for a state `ω` (a positive unital functional on `B(H)`, see `VacuumBellSeparation.State`;
the manuscript speaks of a state on the von Neumann algebra generated by two commuting
von Neumann algebras), orders `r₊ > 2`, `1 < r₋ < 2`
with `η > 0`, finite event comparison constants `K_{r₊,+}`, `K_{r₋,-}` (suprema over local
projections, equation (3.1)), the clustering bound (3.3) and the cutoff inequality (3.5),
the Summers–Werner Bell correlation (2.4) equals `1`.

The proof combines the real-number cell argument (`chsh_box_le_one`), the projection form
for reflection quartets (`chshValue_le_one_of_projection_bounds`), the multi-affine
reduction (`chsh_bound_of_reflections`) and the spectral approximation of self-adjoint
contractions by averages of reflections inside a von Neumann algebra
(`saContractions_subset_closure_convexHull_reflections`).
-/

open scoped ENNReal

namespace VacuumBellSeparation

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Every self-adjoint contraction of a von Neumann algebra is a norm limit of convex
combinations of reflections of that algebra ("every self-adjoint contraction is a spectral
average of reflections"). -/
theorem saContractions_subset_closure_convexHull_reflections (M : VonNeumannAlgebra H) :
    saContractions M ⊆ closure (convexHull ℝ (reflections M)) := by
  intro A hA
  obtain ⟨E, h1, h2, h3, h4, h5, h6, h7⟩ := exists_threshold_projections M hA.1 hA.2.1
  exact mem_closure_convexHull_reflections_of_thresholds M hA E h1 h2 h3 h4 h5 h6 h7

/-- **Theorem 3.1 (two event bounds and clustering).**  Let `ω` be a state and `𝔄`, `𝔅`
commuting von Neumann algebras.  Let `r₊ > 2` and `1 < r₋ < 2` with
`η = 1 - (1 - b)/(a b²) > 0`, where `b = 1 - 1/r₊`, `a = 1 - 1/r₋`.  Suppose
`K_{r₊,+}, K_{r₋,-} < ∞`, and `|ω(AB) - ω(A)ω(B)| ≤ q` for all local self-adjoint
contractions.  If `q^η K_{r₊,+}^{ν₊} K_{r₋,-}^{ν₋} ≤ 2^{-2/(ab)}`, then the Summers–Werner
Bell correlation equals `1`. -/
theorem probability_criterion
    (ω : State H) {𝔄 𝔅 : VonNeumannAlgebra H} (hcomm : Commuting 𝔄 𝔅)
    {rp rm q : ℝ} (hrp : 2 < rp) (hrm : 1 < rm) (hrm2 : rm < 2)
    (hη : 0 < expEta rp rm)
    (hKp : eventConstPlus ω 𝔄 𝔅 rp ≠ ⊤) (hKm : eventConstMinus ω 𝔄 𝔅 rm ≠ ⊤)
    (hcl : ∀ A ∈ saContractions 𝔄, ∀ B ∈ saContractions 𝔅,
      ‖ω (A * B) - ω A * ω B‖ ≤ q)
    (hcut : q ^ expEta rp rm * (eventConstPlus ω 𝔄 𝔅 rp).toReal ^ nuPlus rp rm
        * (eventConstMinus ω 𝔄 𝔅 rm).toReal ^ nuMinus rm
        ≤ (2 : ℝ) ^ (-(2 / (expA rm * expB rp)))) :
    bellCorrelation ω 𝔄 𝔅 = 1 :=
  bellCorrelation_eq_one_of_event_constants_of_approx ω hcomm
    (saContractions_subset_closure_convexHull_reflections 𝔄)
    (saContractions_subset_closure_convexHull_reflections 𝔅)
    hrp hrm hrm2 hη hKp hKm hcl hcut

end VacuumBellSeparation
