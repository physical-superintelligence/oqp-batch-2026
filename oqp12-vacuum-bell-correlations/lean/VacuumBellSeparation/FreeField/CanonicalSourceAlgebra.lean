module

public import VacuumBellSeparation.FreeField.CanonicalSourceDirected
public import VacuumBellSeparation.FreeField.TimeZeroAlgebra

@[expose] public section


/-!
# Actual finite canonical algebras generate the local algebra

All operators act in the original physical vacuum representation. The
directed union below is an algebraic union of von Neumann algebras. Its
double commutant is exactly the time-zero local algebra. Strong density
and bounded approximation are separate analytic conclusions.
-/

namespace VacuumBellSeparation

variable {m : ℝ} {H : Type*}
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The actual Weyl algebra of a real source subspace. -/
noncomputable def canonicalSourceAlgebra (V : FreeFieldVacuum m H) (hm : 0 < m)
    (S : Submodule ℝ TimeZeroSource) : VonNeumannAlgebra H :=
  generatedVNA {T | ∃ u ∈ S, T = V.timeZeroWeyl hm u}

theorem canonicalSourceAlgebra_mono (V : FreeFieldVacuum m H) (hm : 0 < m)
    {S T : Submodule ℝ TimeZeroSource} (hST : S ≤ T) :
    canonicalSourceAlgebra V hm S ≤ canonicalSourceAlgebra V hm T := by
  apply generatedVNA_mono
  rintro A ⟨u, hu, rfl⟩
  exact ⟨u, hST hu, rfl⟩

theorem canonicalSourceAlgebra_le_local (V : FreeFieldVacuum m H) (hm : 0 < m)
    {U : Set (EuclideanSpace ℝ (Fin 3))} {S : Submodule ℝ TimeZeroSource}
    (hS : S ≤ localizedTimeZeroSources U) :
    canonicalSourceAlgebra V hm S ≤ timeZeroLocalAlgebra V hm U := by
  apply generatedVNA_mono
  rintro A ⟨u, hu, rfl⟩
  exact ⟨u, (hS hu).1, (hS hu).2, rfl⟩

theorem timeZeroWeyl_mem_canonicalSourceAlgebra (V : FreeFieldVacuum m H)
    (hm : 0 < m) {S : Submodule ℝ TimeZeroSource} {u : TimeZeroSource} (hu : u ∈ S) :
    V.timeZeroWeyl hm u ∈ canonicalSourceAlgebra V hm S :=
  subset_generatedVNA _ ⟨u, hu, rfl⟩

theorem canonicalSourceAlgebras_directed (V : FreeFieldVacuum m H) (hm : 0 < m)
    {U : Set (EuclideanSpace ℝ (Fin 3))} {S T : Submodule ℝ TimeZeroSource}
    (hS : IsCanonicalSourceSystem U S) (hT : IsCanonicalSourceSystem U T) :
    ∃ R : Submodule ℝ TimeZeroSource, IsCanonicalSourceSystem U R ∧
      canonicalSourceAlgebra V hm S ≤ canonicalSourceAlgebra V hm R ∧
      canonicalSourceAlgebra V hm T ≤ canonicalSourceAlgebra V hm R := by
  obtain ⟨R, hR, hSR, hTR⟩ := canonicalSourceSystems_directed hS hT
  exact ⟨R, hR, canonicalSourceAlgebra_mono V hm hSR,
    canonicalSourceAlgebra_mono V hm hTR⟩

/-- Literal union of all finite canonical algebras in the fixed vacuum. -/
def canonicalAlgebraUnion (V : FreeFieldVacuum m H) (hm : 0 < m)
    (U : Set (EuclideanSpace ℝ (Fin 3))) : Set (H →L[ℂ] H) :=
  {A | ∃ S : Submodule ℝ TimeZeroSource,
    IsCanonicalSourceSystem U S ∧ A ∈ canonicalSourceAlgebra V hm S}

theorem canonicalAlgebraUnion_subset_local (V : FreeFieldVacuum m H) (hm : 0 < m)
    (U : Set (EuclideanSpace ℝ (Fin 3))) :
    canonicalAlgebraUnion V hm U ⊆ timeZeroLocalAlgebra V hm U := by
  rintro A ⟨S, hS, hA⟩
  exact canonicalSourceAlgebra_le_local V hm hS.2.1 hA

/-- The full local double commutant is generated by the actual finite systems. -/
theorem generatedVNA_canonicalAlgebraUnion (V : FreeFieldVacuum m H) (hm : 0 < m)
    (U : Set (EuclideanSpace ℝ (Fin 3))) :
    generatedVNA (canonicalAlgebraUnion V hm U) = timeZeroLocalAlgebra V hm U := by
  apply le_antisymm
  · exact generatedVNA_le_of_subset _ (canonicalAlgebraUnion_subset_local V hm U)
  · apply generatedVNA_mono
    rintro A ⟨u, hf, hg, rfl⟩
    obtain ⟨S, hS, hu⟩ := (mem_localizedTimeZeroSources_iff_exists_canonical u).mp ⟨hf, hg⟩
    exact ⟨S, hS, timeZeroWeyl_mem_canonicalSourceAlgebra V hm hu⟩

end VacuumBellSeparation
