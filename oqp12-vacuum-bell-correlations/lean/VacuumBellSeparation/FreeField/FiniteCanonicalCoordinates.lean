module

public import VacuumBellSeparation.FreeField.FiniteSourceModes
public import VacuumBellSeparation.FreeField.CanonicalSourceAlgebra

@[expose] public section


/-!
# Physical Weyl coordinates of a finite source system

These operators remain in the original vacuum representation. Their
covariance matrix is the literal Fourier covariance on a genuine basis,
and their multiplication phase is the literal source symplectic form.
The full source algebra is generated by these coordinates. Identifying
its cyclic representation with an oscillator density is a separate theorem.
-/

open scoped InnerProductSpace Matrix

namespace VacuumBellSeparation

variable {m : ℝ} (hm : 0 < m) (S : Submodule ℝ TimeZeroSource)
  [FiniteDimensional ℝ S] {ι : Type*} [Fintype ι] [DecidableEq ι]
  (b : Module.Basis ι ℝ (FiniteSourceSpace hm S))

/-- Coordinates parameterize the actual smooth compact test pairs in S. -/
noncomputable def finiteSourceCoordinates : (ι → ℝ) →ₗ[ℝ] TimeZeroSource :=
  S.subtype.comp b.equivFun.symm.toLinearMap

theorem finiteSourceCoordinates_mem (x : ι → ℝ) : finiteSourceCoordinates hm S b x ∈ S :=
  (b.equivFun.symm x).2

theorem range_finiteSourceCoordinates :
    Set.range (finiteSourceCoordinates hm S b) = S := by
  ext u
  constructor
  · rintro ⟨x, rfl⟩
    exact finiteSourceCoordinates_mem hm S b x
  · intro hu
    refine ⟨b.equivFun (⟨u, hu⟩ : FiniteSourceSpace hm S), ?_⟩
    exact congrArg (fun z : FiniteSourceSpace hm S => z.1)
      (b.equivFun.symm_apply_apply (⟨u, hu⟩ : FiniteSourceSpace hm S))

noncomputable def finiteSourceCovarianceMatrix : Matrix ι ι ℝ :=
  fun i j => timeZeroFourierCovariance m (b i).1 (b j).1

noncomputable def finiteSourceSymplecticMatrix : Matrix ι ι ℝ :=
  fun i j => timeZeroSymplectic (b i).1 (b j).1

theorem finiteSourceCoordinates_covariance (x y : ι → ℝ) :
    timeZeroFourierCovariance m (finiteSourceCoordinates hm S b x)
      (finiteSourceCoordinates hm S b y) =
        x ⬝ᵥ (finiteSourceCovarianceMatrix hm S b *ᵥ y) := by
  change timeZeroFourierCovariance m (b.equivFun.symm x).1 (b.equivFun.symm y).1 = _
  rw [← finiteSourceSpace_inner hm S, b.equivFun_symm_apply, b.equivFun_symm_apply]
  simp only [sum_inner, inner_sum, real_inner_smul_left, real_inner_smul_right,
    finiteSourceSpace_inner, finiteSourceCovarianceMatrix, dotProduct, Matrix.mulVec,
    Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

theorem finiteSourceCoordinates_symplectic (x y : ι → ℝ) :
    timeZeroSymplectic (finiteSourceCoordinates hm S b x)
      (finiteSourceCoordinates hm S b y) =
        x ⬝ᵥ (finiteSourceSymplecticMatrix hm S b *ᵥ y) := by
  change timeZeroSymplectic (b.equivFun.symm x).1 (b.equivFun.symm y).1 = _
  rw [← finiteSourceCommutation_symplectic hm S,
    b.equivFun_symm_apply, b.equivFun_symm_apply]
  simp only [map_sum, map_smul, sum_inner, inner_sum,
    real_inner_smul_left, real_inner_smul_right,
    finiteSourceCommutation_symplectic, finiteSourceSymplecticMatrix,
    dotProduct, Matrix.mulVec, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

variable {H : Type*}
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  (V : FreeFieldVacuum m H)

/-- A coordinate Weyl operator in the original physical vacuum. -/
noncomputable def finitePhysicalWeyl (x : ι → ℝ) : H →L[ℂ] H :=
  V.timeZeroWeyl hm (finiteSourceCoordinates hm S b x)

theorem finitePhysicalWeyl_mem_unitary (x : ι → ℝ) :
    finitePhysicalWeyl hm S b V x ∈ unitary (H →L[ℂ] H) :=
  V.timeZeroWeyl_mem_unitary hm _

theorem finitePhysicalWeyl_mul (x y : ι → ℝ) :
    finitePhysicalWeyl hm S b V x * finitePhysicalWeyl hm S b V y =
      Complex.exp (-(Complex.I *
        ((x ⬝ᵥ (finiteSourceSymplecticMatrix hm S b *ᵥ y) / 2 : ℝ) : ℂ))) •
          finitePhysicalWeyl hm S b V (x + y) := by
  have hphase : (timeZeroOneParticleInner m (finiteSourceCoordinates hm S b x)
      (finiteSourceCoordinates hm S b y)).im =
        x ⬝ᵥ (finiteSourceSymplecticMatrix hm S b *ᵥ y) / 2 := by
    rw [← inner_timeZeroL2 hm, inner_timeZeroL2_gram,
      finiteSourceCoordinates_symplectic]
    simp [Complex.mul_im] <;> ring
  unfold finitePhysicalWeyl
  rw [V.timeZeroWeyl_mul, hphase, map_add]

/-- The finite characteristic has the manuscript's covariance and 1/2 factor. -/
theorem vacuum_finitePhysicalWeyl (x : ι → ℝ) :
    ⟪V.vacuum, finitePhysicalWeyl hm S b V x V.vacuum⟫_ℂ =
      ((Real.exp (-(x ⬝ᵥ (finiteSourceCovarianceMatrix hm S b *ᵥ x) / 2)) : ℝ) : ℂ) := by
  rw [finitePhysicalWeyl, V.vacuum_timeZeroWeyl, finiteSourceCoordinates_covariance]

/-- No operators or modes are discarded by the genuine coordinate change. -/
theorem generatedVNA_finitePhysicalWeyl :
    generatedVNA (Set.range (finitePhysicalWeyl hm S b V)) =
      canonicalSourceAlgebra V hm S := by
  congr 1
  ext A
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨finiteSourceCoordinates hm S b x,
      finiteSourceCoordinates_mem hm S b x, rfl⟩
  · rintro ⟨u, hu, rfl⟩
    have hmem : u ∈ Set.range (finiteSourceCoordinates hm S b) := by
      rw [range_finiteSourceCoordinates]
      exact hu
    obtain ⟨x, rfl⟩ := hmem
    exact ⟨x, rfl⟩

end VacuumBellSeparation
