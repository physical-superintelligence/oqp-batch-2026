module

public import VacuumBellSeparation.FreeField.SourceEmbeddingConstruction
public import VacuumBellSeparation.FreeField.TimeZeroNondegenerate
public import VacuumBellSeparation.FreeField.RealCommutation
public import Mathlib.Analysis.InnerProductSpace.Completion
public import Mathlib.Analysis.Normed.Operator.Extend

@[expose] public section


/-!
# The real localized source completion

The test pairs have both compact supports inside the specified spatial set.
Their norm is the actual physical one-particle norm, whose square is the
independently defined Fourier covariance. The completion is a real Hilbert
space with an isometric embedding in the same physical mass-shell `L²`.
Its image is the closure of the local test-vector image. No assertion of
complexified injectivity, cyclicity, time-slice equality or standardness is made.
-/

open scoped InnerProductSpace ComplexConjugate
open MeasureTheory ClosedSubmodule

namespace VacuumBellSeparation

theorem localizedTimeZeroSources_mono {U V : Set (EuclideanSpace ℝ (Fin 3))}
    (hUV : U ⊆ V) : localizedTimeZeroSources U ≤ localizedTimeZeroSources V :=
  fun _ hu => ⟨hu.1.trans hUV, hu.2.trans hUV⟩

variable {m : ℝ} (hm : 0 < m) (U : Set (EuclideanSpace ℝ (Fin 3)))

/-- The completed norm is the covariance norm, not an auxiliary test-function norm. -/
theorem sourceTestSpace_norm_sq (u : SourceTestSpace hm U) :
    ‖u‖ ^ 2 = timeZeroFourierCovariance m u.1 u.1 :=
  norm_timeZeroL2_sq hm u.1

theorem sourceEmbedding_coe (u : SourceTestSpace hm U) :
    sourceEmbedding hm U (u : SourceHilbert hm U) = timeZeroL2 hm u.1 :=
  (sourceTestIsometry hm U).fromCompletion_apply_coe u

theorem isClosed_range_sourceEmbedding : IsClosed (Set.range (sourceEmbedding hm U)) :=
  (sourceEmbedding hm U).isometry.isClosedEmbedding.isClosed_range

/-- The completed image is exactly the closure of the local test-vector image. -/
theorem range_sourceEmbedding_eq_closure :
    Set.range (sourceEmbedding hm U) = closure (Set.range (sourceTestMap hm U)) := by
  apply Set.Subset.antisymm
  · rintro _ ⟨z, rfl⟩
    refine UniformSpace.Completion.induction_on z
      (isClosed_closure.preimage (sourceEmbedding hm U).continuous) ?_
    intro u
    apply subset_closure
    exact ⟨u, (sourceEmbedding_coe hm U u).symm⟩
  · apply closure_minimal ?_ (isClosed_range_sourceEmbedding hm U)
    rintro _ ⟨u, rfl⟩
    exact ⟨(u : SourceHilbert hm U), sourceEmbedding_coe hm U u⟩

/-- The physical closed real subspace generated by the local time-zero sources. -/
noncomputable def sourceRealSpace : ClosedSubmodule ℝ (Lp ℂ 2 (oneParticleMeasure m)) where
  toSubmodule := (sourceEmbedding hm U).toLinearMap.range
  isClosed' := isClosed_range_sourceEmbedding hm U

/-- The actual commutation operator of the completed real source space. -/
noncomputable def sourceCommutation : SourceHilbert hm U →L[ℝ] SourceHilbert hm U :=
  realCommutation (sourceEmbedding hm U)

theorem sourceCommutation_mem_skewAdjoint :
    sourceCommutation hm U ∈ skewAdjoint (SourceHilbert hm U →L[ℝ] SourceHilbert hm U) :=
  realCommutation_mem_skewAdjoint (sourceEmbedding hm U)

theorem norm_sourceCommutation_le_two : ‖sourceCommutation hm U‖ ≤ 2 :=
  norm_realCommutation_le_two (sourceEmbedding hm U)

/-- On test sources the completed operator represents the position-space symplectic integral. -/
theorem sourceCommutation_symplectic (u v : SourceTestSpace hm U) :
    ⟪(u : SourceHilbert hm U), sourceCommutation hm U (v : SourceHilbert hm U)⟫_ℝ =
      timeZeroSymplectic u.1 v.1 := by
  erw [sourceCommutation, inner_realCommutation, sourceEmbedding_coe, sourceEmbedding_coe,
    inner_timeZeroL2_gram]
  simp [Complex.mul_im] <;> ring

end VacuumBellSeparation
