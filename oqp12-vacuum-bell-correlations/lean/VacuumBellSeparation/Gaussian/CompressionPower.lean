module

public import VacuumBellSeparation.Gaussian.Compression

@[expose] public section


/-!
# Powers under compression

The full low-compression claim (4.10) of manuscript Lemma 4.4. On an algebra
commuting with the image projection, compression is a unital star-algebra
homomorphism. Mathlib's functional-calculus naturality and operator concavity,
applied to the reflection average, yield the power compression inequality.
-/

namespace VacuumBellSeparation.Gaussian

open ContinuousLinearMap
open scoped NNReal

variable {E F : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]

theorem imageProjection_apply_embedding (ι : E →ₗᵢ[ℂ] F) (x : E) :
    imageProjection ι (ι x) = ι x := by
  simp [imageProjection]

/-- An operator commuting with the image projection preserves the image. -/
theorem imageProjection_apply_of_commute (ι : E →ₗᵢ[ℂ] F) {A : F →L[ℂ] F}
    (hA : Commute A (imageProjection ι)) (x : E) :
    imageProjection ι (A (ι x)) = A (ι x) := by
  have h := DFunLike.congr_fun hA.eq (ι x)
  simpa only [mul_apply_eq_comp, imageProjection_apply_embedding] using h.symm

/-- Compression is multiplicative when the right factor preserves the image. -/
theorem compression_mul_of_commute (ι : E →ₗᵢ[ℂ] F) (A : F →L[ℂ] F)
    {B : F →L[ℂ] F} (hB : Commute B (imageProjection ι)) :
    compression ι (A * B) = compression ι A * compression ι B := by
  ext x
  change ι.toContinuousLinearMap.adjoint (A (B (ι x))) =
    ι.toContinuousLinearMap.adjoint (A (imageProjection ι (B (ι x))))
  rw [imageProjection_apply_of_commute ι hB]

theorem elemental_commute_imageProjection (ι : E →ₗᵢ[ℂ] F) {A : F →L[ℂ] F}
    (hA : IsSelfAdjoint A) (hAP : Commute A (imageProjection ι))
    (X : StarAlgebra.elemental ℂ A) : Commute (X : F →L[ℂ] F) (imageProjection ι) := by
  have hP : imageProjection ι ∈ StarSubalgebra.centralizer ℂ ({A} : Set (F →L[ℂ] F)) := by
    rw [StarSubalgebra.mem_centralizer_iff]
    intro g hg
    rcases Set.mem_singleton_iff.mp hg with rfl
    exact ⟨hAP.eq, by simpa only [hA.star_eq] using hAP.eq⟩
  have hX := StarAlgebra.elemental.le_centralizer_centralizer ℂ A X.property
  exact (((StarSubalgebra.mem_centralizer_iff ℂ).mp hX) _ hP).1.symm

/-- On the closed star algebra generated by a self-adjoint operator commuting
with the image projection, compression is an actual unital star homomorphism. -/
noncomputable def compressionOnElemental (ι : E →ₗᵢ[ℂ] F) {A : F →L[ℂ] F}
    (hA : IsSelfAdjoint A) (hAP : Commute A (imageProjection ι)) :
    StarAlgebra.elemental ℂ A →⋆ₐ[ℂ] (E →L[ℂ] E) where
  toFun X := compression ι X
  map_one' := compression_one ι
  map_mul' X Y := compression_mul_of_commute ι X (elemental_commute_imageProjection ι hA hAP Y)
  map_zero' := by ext x; simp [compression]
  map_add' X Y := by ext x; simp [compression]
  commutes' r := by
    ext x
    simp [compression, Algebra.algebraMap_eq_smul_one]
  map_star' X := by
    change compression ι (star (X : F →L[ℂ] F)) = star (compression ι X)
    ext x
    simp [compression, star_eq_adjoint]

/-- Functional calculus commutes with compression when the operator commutes
with the image projection. This statement concerns positive real powers and
requires neither finite dimension nor invertibility. -/
theorem compression_rpow_of_commute (ι : E →ₗᵢ[ℂ] F) {A : F →L[ℂ] F}
    (hA : 0 ≤ A) (hAP : Commute A (imageProjection ι)) {p : ℝ} (hp : 0 < p) :
    compression ι (A ^ p) = (compression ι A) ^ p := by
  letI : IsClosed (StarAlgebra.elemental ℂ A : Set (F →L[ℂ] F)) :=
    StarAlgebra.elemental.isClosed ℂ A
  let X : StarAlgebra.elemental ℂ A := ⟨A, StarAlgebra.elemental.self_mem ℂ A⟩
  let φ := compressionOnElemental ι hA.isSelfAdjoint hAP
  have hX : IsSelfAdjoint X := by
    apply Subtype.ext
    exact hA.isSelfAdjoint.star_eq
  have hi := (StarAlgebra.elemental ℂ A).subtype.map_cfc
    (fun x : ℝ => x ^ p) X
    (hf := (Real.continuous_rpow_const hp.le).continuousOn)
    (hφ := continuous_subtype_val)
    (ha := hX) (hφa := hA.isSelfAdjoint)
  have hφ : Continuous φ := by
    change Continuous (fun X : StarAlgebra.elemental ℂ A =>
      ι.toContinuousLinearMap.adjoint ∘L (X : F →L[ℂ] F) ∘L ι.toContinuousLinearMap)
    fun_prop
  have hc := φ.map_cfc (fun x : ℝ => x ^ p) X
    (hf := (Real.continuous_rpow_const hp.le).continuousOn)
    (hφ := hφ) (ha := hX) (hφa := (compression_nonneg ι hA).isSelfAdjoint)
  change compression ι ((cfc (fun x : ℝ => x ^ p) X : StarAlgebra.elemental ℂ A) :
    F →L[ℂ] F) = cfc (fun x : ℝ => x ^ p) (compression ι A) at hc
  change ((cfc (fun x : ℝ => x ^ p) X : StarAlgebra.elemental ℂ A) :
    F →L[ℂ] F) = cfc (fun x : ℝ => x ^ p) A at hi
  rw [hi] at hc
  rw [CFC.rpow_eq_cfc_real hA, CFC.rpow_eq_cfc_real (compression_nonneg ι hA)]
  exact hc

/-- Reflection across the image of an isometric embedding. -/
noncomputable def imageReflection (ι : E →ₗᵢ[ℂ] F) : F →L[ℂ] F :=
  2 * imageProjection ι - 1

theorem imageReflection_isSelfAdjoint (ι : E →ₗᵢ[ℂ] F) :
    IsSelfAdjoint (imageReflection ι) := by
  change star (2 * imageProjection ι - 1) = 2 * imageProjection ι - 1
  simp only [two_mul, star_sub, star_add,
    (imageProjection_isStarProjection ι).isSelfAdjoint.star_eq, star_one]

theorem imageReflection_mem_unitary (ι : E →ₗᵢ[ℂ] F) :
    imageReflection ι ∈ unitary (F →L[ℂ] F) :=
  (imageProjection_isStarProjection ι).two_mul_sub_one_mem_unitary

theorem imageReflection_mul_self (ι : E →ₗᵢ[ℂ] F) :
    imageReflection ι * imageReflection ι = 1 := by
  simpa only [(imageReflection_isSelfAdjoint ι).star_eq] using
    (imageReflection_mem_unitary ι).1

/-- Average with conjugation by the image reflection; equivalently, erase the
off-diagonal blocks between the image and its orthogonal complement. -/
noncomputable def pinching (ι : E →ₗᵢ[ℂ] F) (A : F →L[ℂ] F) : F →L[ℂ] F :=
  (1 / 2 : ℝ) • A + (1 / 2 : ℝ) • (imageReflection ι * A * imageReflection ι)

theorem pinching_nonneg (ι : E →ₗᵢ[ℂ] F) {A : F →L[ℂ] F} (hA : 0 ≤ A) :
    0 ≤ pinching ι A := by
  apply add_nonneg (smul_nonneg (by norm_num) hA)
  exact smul_nonneg (by norm_num) ((imageReflection_isSelfAdjoint ι).conjugate_nonneg hA)

theorem pinching_commute_imageProjection (ι : E →ₗᵢ[ℂ] F) (A : F →L[ℂ] F) :
    Commute (pinching ι A) (imageProjection ι) := by
  let U := imageReflection ι
  have hU : U * U = 1 := imageReflection_mul_self ι
  have hcomm : Commute (pinching ι A) U := by
    change ((1 / 2 : ℝ) • A + (1 / 2 : ℝ) • (U * A * U)) * U =
      U * ((1 / 2 : ℝ) • A + (1 / 2 : ℝ) • (U * A * U))
    have hr : U * A * U * U = U * A := by rw [mul_assoc (U * A), hU, mul_one]
    have hl : U * (U * A * U) = A * U := by rw [← mul_assoc, ← mul_assoc, hU, one_mul]
    simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, hr, hl]
    abel
  have hP : imageProjection ι = (1 / 2 : ℝ) • (U + 1) := by
    dsimp [U, imageReflection]
    rw [two_mul]
    module
  rw [hP]
  exact (hcomm.add_right (Commute.one_right _)).smul_right _

theorem compression_pinching (ι : E →ₗᵢ[ℂ] F) (A : F →L[ℂ] F) :
    compression ι (pinching ι A) = compression ι A := by
  have hright (x : E) : imageReflection ι (ι x) = ι x := by
    simp [imageReflection, two_mul, imageProjection_apply_embedding]
  have hleft (x : F) : ι.toContinuousLinearMap.adjoint (imageReflection ι x) =
      ι.toContinuousLinearMap.adjoint x := by
    simp [imageReflection, imageProjection, two_mul]
  ext x
  change ι.toContinuousLinearMap.adjoint
    ((1 / 2 : ℝ) • A (ι x) + (1 / 2 : ℝ) •
      imageReflection ι (A (imageReflection ι (ι x)))) =
    ι.toContinuousLinearMap.adjoint (A (ι x))
  rw [hright, map_add, map_smul_of_tower, map_smul_of_tower, hleft, ← add_smul]
  norm_num

/-- Real powers commute with unitary conjugation, by Mathlib's CFC naturality. -/
theorem unitary_conjugate_rpow (U : unitary (F →L[ℂ] F)) {A : F →L[ℂ] F}
    (hA : 0 ≤ A) {p : ℝ} (hp : 0 < p) :
    ((U : F →L[ℂ] F) * A * star (U : F →L[ℂ] F)) ^ p =
      (U : F →L[ℂ] F) * A ^ p * star (U : F →L[ℂ] F) := by
  let φ := (Unitary.conjStarAlgAut ℂ (F →L[ℂ] F) U).toStarAlgHom
  have h := φ.map_cfc (fun x : ℝ≥0 => x ^ p) A
    (ha := hA) (hφa := star_right_conjugate_nonneg hA U)
  exact h.symm

/-- Jensen's inequality for positive real powers under a Hilbert-space
compression, proved from the reflection average and operator concavity. -/
theorem compression_rpow_le (ι : E →ₗᵢ[ℂ] F) {A : F →L[ℂ] F} (hA : 0 ≤ A)
    {p : ℝ} (hp0 : 0 < p) (hp1 : p ≤ 1) :
    compression ι (A ^ p) ≤ (compression ι A) ^ p := by
  let U : unitary (F →L[ℂ] F) := ⟨imageReflection ι, imageReflection_mem_unitary ι⟩
  have hUstar : star (U : F →L[ℂ] F) = U := (imageReflection_isSelfAdjoint ι).star_eq
  have hconj : (0 : F →L[ℂ] F) ≤ (U : F →L[ℂ] F) * A * U := by
    simpa only [hUstar] using star_right_conjugate_nonneg hA (U : F →L[ℂ] F)
  have hc := (CFC.concaveOn_rpow (A := F →L[ℂ] F) ⟨hp0.le, hp1⟩).2
    hA hconj (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (0 : ℝ) ≤ 1 / 2)
    (by norm_num : (1 / 2 : ℝ) + 1 / 2 = 1)
  have hnat := unitary_conjugate_rpow U hA hp0
  rw [hUstar] at hnat
  have hc' : pinching ι (A ^ p) ≤ (pinching ι A) ^ p := by
    simpa only [pinching, hnat] using hc
  have h := compression_mono ι hc'
  rw [compression_pinching,
    compression_rpow_of_commute ι (pinching_nonneg ι hA)
      (pinching_commute_imageProjection ι A) hp0,
    compression_pinching] at h
  exact h

/-- The entire low-compression claim (4.10), in normalized commutation
coordinates: `ι* R^(2a) ι ≤ R_F^(2a)` for `0 < a ≤ 1/2`. -/
theorem low_compression (ι : E →ₗᵢ[ℂ] F) {B : F →L[ℂ] F}
    (hB : IsSelfAdjoint B) (hnorm : ‖B‖ ≤ 1) {a : ℝ}
    (ha0 : 0 < a) (ha1 : a ≤ 1 / 2) :
    compression ι ((reserve B) ^ (2 * a)) ≤ (reserve (compression ι B)) ^ (2 * a) := by
  have hp : 2 * a ∈ Set.Icc (0 : ℝ) 1 := ⟨by linarith, by linarith⟩
  exact (compression_rpow_le ι (CFC.sqrt_nonneg _) (by linarith) hp.2).trans
    (CFC.rpow_le_rpow hp (compression_reserve_le_of_norm_le_one ι hB hnorm))

end VacuumBellSeparation.Gaussian
