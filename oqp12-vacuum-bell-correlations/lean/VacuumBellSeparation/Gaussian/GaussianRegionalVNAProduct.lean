module

public import VacuumBellSeparation.Gaussian.GaussianRegionalProduct
public import VacuumBellSeparation.Gaussian.DensityProductVNA

@[expose] public section


/-!
# Gaussian product state on actual regional von Neumann algebra effects

The regional algebras are generated by the literal physical oscillator
Weyl operators. Symplectically orthogonal label spaces and zero covariance
cross block imply product expectations for all their actual effects.
The result passes through proved polynomial, norm-closure and bounded
strong limits; no operator-algebra independence hypothesis is introduced.
-/

namespace VacuumBellSeparation.Gaussian

open Matrix

variable {m : ℕ}

theorem generatedVNA_regionalWeylCStarAlgebra
    (L : Submodule ℝ (Fin m × Fin 2 → ℝ)) :
    generatedVNA (regionalWeylCStarAlgebra L : Set
      (MultiModeOscillatorSpace m →L[ℂ] MultiModeOscillatorSpace m)) =
        generatedVNA (regionalWeylGenerators L) := by
  rw [regionalWeylCStarAlgebra, regionalWeylPolynomialAlgebra_eq_adjoin,
    generatedVNA_closed_star_adjoin]

/-- The actual joint probability factors for every pair of regional effects.
Both vanishing cross forms are essential explicit hypotheses. -/
theorem gaussianPhysical_regional_vna_effect_product
    {ρ : MultiModeOscillatorSpace m →L[ℂ] MultiModeOscillatorSpace m}
    (hρ : IsPositiveTraceClass ρ)
    {V : Matrix (Fin m × Fin 2) (Fin m × Fin 2) ℝ}
    (hV : V.IsHermitian) (hG : HasGaussianPhysicalCharacteristic ρ V)
    (L R : Submodule ℝ (Fin m × Fin 2 → ℝ))
    (hΩ : ∀ x ∈ L, ∀ y ∈ R, x ⬝ᵥ (modeSymplecticForm *ᵥ y) = 0)
    (hcov : ∀ x ∈ L, ∀ y ∈ R, x ⬝ᵥ (V *ᵥ y) = 0)
    {A B : MultiModeOscillatorSpace m →L[ℂ] MultiModeOscillatorSpace m}
    (hA : A ∈ generatedVNA (regionalWeylGenerators L)) (hA0 : 0 ≤ A) (hA1 : A ≤ 1)
    (hB : B ∈ generatedVNA (regionalWeylGenerators R)) (hB0 : 0 ≤ B) (hB1 : B ≤ 1) :
    densityExpectation (multiModeNumberBasis m) ρ (A * B) =
      densityExpectation (multiModeNumberBasis m) ρ A *
        densityExpectation (multiModeNumberBasis m) ρ B := by
  apply densityExpectation_product_generatedVNA_effects (multiModeNumberBasis m) hρ
    (regionalWeylCStarAlgebra L) (regionalWeylCStarAlgebra R)
    (regionalWeylPolynomialAlgebra L).isClosed_topologicalClosure
    (regionalWeylPolynomialAlgebra R).isClosed_topologicalClosure
    (fun A hA B hB => gaussianPhysical_regional_cstar_product hρ hV hG L R hΩ hcov hA hB)
    ?_ hA0 hA1 ?_ hB0 hB1
  · simpa only [generatedVNA_regionalWeylCStarAlgebra] using hA
  · simpa only [generatedVNA_regionalWeylCStarAlgebra] using hB

end VacuumBellSeparation.Gaussian
