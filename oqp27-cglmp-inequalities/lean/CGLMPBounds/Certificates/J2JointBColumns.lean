theorem joint_B_monomial_sum_eq_source (θ u : ℝ) :
    (∑ p : Fin 40, ∑ q : Fin 20, (jointBMonomial p q : ℝ) * θ ^ p.val * u ^ q.val) =
      (1 - 2 * θ) *
        (scalarNumerator θ (1 - (θ + (1 - 3 * θ) * u)) -
          scalarNumerator θ (θ + (1 - 3 * θ) * u)) := by
  rw [bivariate_sum_by_columns]
  simp_rw [jointB_column_eval, jointB_column_source]
  have hsum : (∑ q : Fin 20, (1 - 2 * θ) *
      (affineColumn19 (sourceColumn19 θ) (1 - θ) (-(1 - 3 * θ)) q -
        affineColumn19 (sourceColumn19 θ) θ (1 - 3 * θ) q) * u ^ q.val) =
      (1 - 2 * θ) *
        ((∑ q : Fin 20, affineColumn19 (sourceColumn19 θ) (1 - θ) (-(1 - 3 * θ)) q * u ^ q.val) -
          ∑ q : Fin 20, affineColumn19 (sourceColumn19 θ) θ (1 - 3 * θ) q * u ^ q.val) := by
    rw [← Finset.sum_sub_distrib, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro q _
    ring
  rw [hsum, ← scalarNumerator_affine19, ← scalarNumerator_affine19]
  have harg : (1 - θ) + (-(1 - 3 * θ)) * u = 1 - (θ + (1 - 3 * θ) * u) := by ring
