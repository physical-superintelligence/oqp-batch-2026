set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

theorem joint_A_theta_transform : ∀ i : Fin 40, ∀ q : Fin 20,
    jointAThetaCoefficient i q = ∑ p : Fin 40,
      (jointAMonomial p q : ℚ) * certificateChoose i.val p.val /
        ((3 : ℚ) ^ p.val * certificateChoose 39 p.val) := by
  decide +kernel

theorem joint_A_u_transform : ∀ i : Fin 40, ∀ j : Fin 20,
    jointACoefficient i j = ∑ q : Fin 20,
      jointAThetaCoefficient i q * certificateChoose j.val q.val /
        certificateChoose 19 q.val := by
  decide +kernel

theorem joint_B_theta_transform : ∀ i : Fin 40, ∀ q : Fin 20,
    jointBThetaCoefficient i q = ∑ p : Fin 40,
      (jointBMonomial p q : ℚ) * certificateChoose i.val p.val /
        ((3 : ℚ) ^ p.val * certificateChoose 39 p.val) := by
  decide +kernel

theorem joint_B_u_transform : ∀ i : Fin 40, ∀ j : Fin 20,
    jointBCoefficient i j = ∑ q : Fin 20,
      jointBThetaCoefficient i q * certificateChoose j.val q.val /
        certificateChoose 19 q.val := by
  decide +kernel

theorem joint_D_transform : ∀ i : Fin 40,
    jointDCoefficient i = ∑ p : Fin 40,
      (jointDMonomial p : ℚ) * certificateChoose i.val p.val /
        ((3 : ℚ) ^ p.val * certificateChoose 39 p.val) := by
  decide +kernel

theorem joint_T_transform : ∀ i : Fin 40,
    jointTCoefficient i = ∑ p : Fin 40,
      (jointTMonomial p : ℚ) * certificateChoose i.val p.val /
        ((3 : ℚ) ^ p.val * certificateChoose 39 p.val) := by
  decide +kernel

/-- The 800 interval coefficients are bounded below by the displayed row minima. -/
theorem joint_A_lower : ∀ i : Fin 40, ∀ j : Fin 20,
    jointALower i ≤ jointACoefficient i j := by
  decide +kernel

/-- Both signs of each of the 8400 simplex coefficients are bounded by the row envelope. -/
theorem joint_B_upper : ∀ i : Fin 40, ∀ g : Fin 210,
    |∑ l : Fin 3, jointBCoefficient i (simplex19Index g l)| ≤ jointBUpper i := by
  decide +kernel

/-- The forty strict margins printed in Table J.2. -/
theorem joint_strict_margins : ∀ i : Fin 40,
    (10^12 : ℚ) * (19568 * jointDCoefficient i + 810 * jointTCoefficient i) +
      120000 * jointALower i - 300000 * jointBUpper i >
        20 * (10^12 : ℚ) * jointDCoefficient i := by
  decide +kernel

/-- A common lower bound on denominator coefficients. -/
theorem joint_D_ge_one : ∀ i : Fin 40, 1 ≤ jointDCoefficient i := by
  decide +kernel

/-- Positive denominator coefficients for converting the strict margin to positivity. -/
theorem joint_D_positive (i : Fin 40) : 0 < jointDCoefficient i :=
  lt_of_lt_of_le (by norm_num) (joint_D_ge_one i)

