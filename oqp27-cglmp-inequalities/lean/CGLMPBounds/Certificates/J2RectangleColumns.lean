theorem rectangle_monomial_sum_eq_source (θ u : ℝ) :
    (∑ p : Fin 39, ∑ q : Fin 20, (rectangleMonomial p q : ℝ) * θ ^ p.val * u ^ q.val) =
      100 * scalarNumerator θ (scalarY θ u) +
        3 * scalarCoefficientScale * scalarDstar θ := by
  rw [bivariate_sum_by_columns]
  simp_rw [rectangle_column_eval, rectangle_column_source, add_mul]
  rw [Finset.sum_add_distrib]
  have hconstant : (∑ q : Fin 20,
      (if q = 0 then 3 * scalarCoefficientScale * scalarDstar θ else 0) * u ^ q.val) =
      3 * scalarCoefficientScale * scalarDstar θ := by simp [ite_mul]
  rw [hconstant]
  have hmain : (∑ q : Fin 20,
      100 * affineColumn19 (sourceColumn19 θ) θ (1 - 2 * θ) q * u ^ q.val) =
      100 * scalarNumerator θ (scalarY θ u) := by
    rw [scalarY, scalarNumerator_affine19, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro q _
    ring
  rw [hmain]

