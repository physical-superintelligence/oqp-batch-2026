set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

/-- First stage: only the theta coordinate is converted to Bernstein degree 38. -/
theorem rectangle_theta_transform : ∀ i : Fin 39, ∀ q : Fin 20,
    rectangleThetaCoefficient i q = ∑ p : Fin 39,
      (rectangleMonomial p q : ℚ) * certificateChoose i.val p.val /
        ((2 : ℚ) ^ p.val * certificateChoose 38 p.val) := by
  decide +kernel

/-- Second stage: convert the u coordinate to Bernstein degree 19. -/
theorem rectangle_u_transform : ∀ i : Fin 39, ∀ j : Fin 20,
    rectangleCoefficient i j = ∑ q : Fin 20,
      rectangleThetaCoefficient i q * certificateChoose j.val q.val /
        certificateChoose 19 q.val := by
  decide +kernel

/-- A common positive lower bound for all 780 exact product-Bernstein coefficients. -/
theorem rectangle_coefficients_ge_one : ∀ i : Fin 39, ∀ j : Fin 20,
    1 ≤ rectangleCoefficient i j := by
  decide +kernel

/-- All 780 exact product-Bernstein coefficients are strictly positive. -/
theorem rectangle_coefficients_pos (i : Fin 39) (j : Fin 20) :
    0 < rectangleCoefficient i j :=
  lt_of_lt_of_le (by norm_num) (rectangle_coefficients_ge_one i j)

end CGLMPBounds.Certificates
