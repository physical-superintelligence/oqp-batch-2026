/-- A fixed-degree affine substitution, independent of all manuscript data.
The printed binomial integers in affineColumn19 are checked by this ring identity. -/
theorem affine_expansion19 (c : Fin 20 → ℝ) (a b u : ℝ) :
    (∑ k : Fin 20, c k * (a + b * u) ^ k.val) =
      ∑ q : Fin 20, affineColumn19 c a b q * u ^ q.val := by
  norm_num [Fin.sum_univ_succ, affineColumn19_eq_0, affineColumn19_eq_1, affineColumn19_eq_2, affineColumn19_eq_3, affineColumn19_eq_4, affineColumn19_eq_5, affineColumn19_eq_6, affineColumn19_eq_7, affineColumn19_eq_8, affineColumn19_eq_9, affineColumn19_eq_10, affineColumn19_eq_11, affineColumn19_eq_12, affineColumn19_eq_13, affineColumn19_eq_14, affineColumn19_eq_15, affineColumn19_eq_16, affineColumn19_eq_17, affineColumn19_eq_18, affineColumn19_eq_19] <;> ring


/-- The affine expansion refers to the actual source numerator, also at theta=0. -/
theorem scalarNumerator_affine19 (θ a b u : ℝ) :
    scalarNumerator θ (a + b * u) =
      ∑ q : Fin 20, affineColumn19 (sourceColumn19 θ) a b q * u ^ q.val := by
  rw [scalarNumerator_eq_expanded, scalarExpanded_eq_columns]
  exact affine_expansion19 (sourceColumn19 θ) a b u

/-- Regrouping a finite bivariate table by its second-coordinate columns. -/
theorem bivariate_sum_by_columns {n m : ℕ} (M : Fin n → Fin m → ℝ) (θ u : ℝ) :
    (∑ p : Fin n, ∑ q : Fin m, M p q * θ ^ p.val * u ^ q.val) =
      ∑ q : Fin m, (∑ p : Fin n, M p q * θ ^ p.val) * u ^ q.val := by
  rw [Finset.sum_comm]
  simp only [Finset.sum_mul]

