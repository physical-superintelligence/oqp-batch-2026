    (2954160995036517826560000 : ℝ) * θ ^ 19 * y ^ 19

set_option maxHeartbeats 10000000 in
/-- Clearing the single removable division recovers exactly the factored source expression. -/
theorem scalarExpanded_cleared (θ y : ℝ) :
    θ * scalarExpanded θ y =
      ∑ i : Fin 10, (scalarCoefficientNumerator i : ℝ) * scalarDquotient (2 * i.val + 1) θ
        * scalarB (2 * i.val + 1) θ y := by
  norm_num [scalarExpanded, scalarCoefficientNumerator, scalarDquotient, scalarB, scalarD,
    scalarP, Fin.sum_univ_succ, Finset.prod_range_succ]
  ring

/-- The generated expression is the actual N, including its removable value at zero. -/
theorem scalarNumerator_eq_expanded (θ y : ℝ) :
    scalarNumerator θ y = scalarExpanded θ y := by
  by_cases hθ : θ = 0
  · subst θ
    norm_num [scalarNumerator, scalarExpanded]
  · unfold scalarNumerator
    simp_rw [← mul_div_assoc]
    rw [← Finset.sum_div, ← scalarExpanded_cleared]
    field_simp

end

end CGLMPBounds
