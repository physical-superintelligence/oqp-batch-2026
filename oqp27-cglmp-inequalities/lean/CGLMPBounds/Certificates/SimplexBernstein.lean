/-- Every listed triple has total degree 19. -/
theorem simplex19Index_sum : ∀ g : Fin 210,
    ∑ l : Fin 3, (simplex19Index g l).val = 19 := by
  decide +kernel

/-- Kernel-checked identification of every integer coefficient with its
multinomial factorial identity. No generated coefficient is trusted. -/
theorem simplex19Coefficient_factorial : ∀ g : Fin 210,
    (Nat.factorial (simplex19Index g 0).val *
      Nat.factorial (simplex19Index g 1).val *
      Nat.factorial (simplex19Index g 2).val) * simplex19Coefficient g =
        Nat.factorial 19 := by
  decide +kernel

/-- The actual degree-19 simplex Bernstein monomial. -/
noncomputable def simplex19Weight (α : Fin 3 → ℝ) (g : Fin 210) : ℝ :=
  (simplex19Coefficient g : ℝ) * α 0 ^ (simplex19Index g 0).val *
    α 1 ^ (simplex19Index g 1).val * α 2 ^ (simplex19Index g 2).val

theorem simplex19Weight_nonneg (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (g : Fin 210) : 0 ≤ simplex19Weight α g := by
  unfold simplex19Weight
  exact mul_nonneg
    (mul_nonneg
      (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (hα 0) _))
      (pow_nonneg (hα 1) _))
    (pow_nonneg (hα 2) _)

/-- Homogeneous marginal identity before restricting to the simplex.
There are only 3*20 cases; each is an exact real polynomial identity. -/
theorem simplex19_marginal_homogeneous (α : Fin 3 → ℝ) (l : Fin 3) (j : Fin 20) :
    (∑ g : Fin 210, if simplex19Index g l = j then simplex19Weight α g else 0) =
      (Nat.choose 19 j.val : ℝ) * α l ^ j.val *
        ((∑ m : Fin 3, α m) - α l) ^ (19 - j.val) := by
  fin_cases l <;> fin_cases j <;>
    norm_num [simplex19Index, simplex19Coefficient, simplex19Weight,
      Fin.sum_univ_succ, Nat.choose_eq_fast_choose, Nat.fast_choose,
      Nat.descFactorial, Nat.factorial] <;> ring

/-- A coordinate of a nonnegative simplex point lies in the unit interval. -/
theorem simplex19_coordinate_mem (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) (l : Fin 3) : α l ∈ Set.Icc (0 : ℝ) 1 := by
  refine ⟨hα l, ?_⟩
  have hle : α l ≤ ∑ m : Fin 3, α m :=
    Finset.single_le_sum (fun m _ => hα m) (Finset.mem_univ l)
  simpa only [hsum] using hle

/-- A simplex coordinate bundled for Mathlib's Bernstein polynomial API. -/
def simplex19Point (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) (l : Fin 3) : unitInterval :=
  ⟨α l, simplex19_coordinate_mem α hα hsum l⟩

@[simp] theorem simplex19Point_coe (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) (l : Fin 3) :
    (simplex19Point α hα hsum l : ℝ) = α l := rfl

/-- Summing over the other two exponent coordinates gives the corresponding
one-variable Bernstein weight. -/
theorem simplex19_marginal (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) (l : Fin 3) (j : Fin 20) :
    (∑ g : Fin 210, if simplex19Index g l = j then simplex19Weight α g else 0) =
      bernstein 19 j (simplex19Point α hα hsum l) := by
  rw [simplex19_marginal_homogeneous, bernstein_apply, simplex19Point_coe, hsum]

/-- The simplex weights form a partition of unity, including boundary points. -/
theorem simplex19_probability (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) : ∑ g : Fin 210, simplex19Weight α g = 1 := by
  calc
    _ = ∑ g : Fin 210, ∑ j : Fin 20,
        if simplex19Index g 0 = j then simplex19Weight α g else 0 := by
      apply Finset.sum_congr rfl
      intro g _
      simp
    _ = ∑ j : Fin 20, ∑ g : Fin 210,
        if simplex19Index g 0 = j then simplex19Weight α g else 0 := Finset.sum_comm
    _ = ∑ j : Fin 20, bernstein 19 j (simplex19Point α hα hsum 0) := by
      apply Finset.sum_congr rfl
      intro j _
      exact simplex19_marginal α hα hsum 0 j
    _ = 1 := bernstein.probability 19 (simplex19Point α hα hsum 0)

/-- Arbitrary coefficients on a single coordinate transfer to the simplex basis. -/
theorem simplex19_coordinate_transfer (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) (l : Fin 3) (c : Fin 20 → ℝ) :
    (∑ j : Fin 20, c j * bernstein 19 j (simplex19Point α hα hsum l)) =
      ∑ g : Fin 210, c (simplex19Index g l) * simplex19Weight α g := by
  calc
    _ = ∑ j : Fin 20, c j * ∑ g : Fin 210,
        if simplex19Index g l = j then simplex19Weight α g else 0 := by
      apply Finset.sum_congr rfl
      intro j _
      rw [simplex19_marginal]
    _ = ∑ j : Fin 20, ∑ g : Fin 210,
        if simplex19Index g l = j then c j * simplex19Weight α g else 0 := by
      simp only [Finset.mul_sum, mul_ite, mul_zero]
    _ = ∑ g : Fin 210, ∑ j : Fin 20,
        if simplex19Index g l = j then c j * simplex19Weight α g else 0 := Finset.sum_comm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro g _
      simp

/-- Each of the three coordinates may have its own coefficient sequence.
This is the separable-summand transfer needed for the joint Appendix J domain. -/
theorem simplex19_separable_transfer (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) (c : Fin 3 → Fin 20 → ℝ) :
    (∑ l : Fin 3, ∑ j : Fin 20,
      c l j * bernstein 19 j (simplex19Point α hα hsum l)) =
        ∑ g : Fin 210, (∑ l : Fin 3, c l (simplex19Index g l)) *
          simplex19Weight α g := by
  calc
    _ = ∑ l : Fin 3, ∑ g : Fin 210,
        c l (simplex19Index g l) * simplex19Weight α g := by
      apply Finset.sum_congr rfl
      intro l _
      exact simplex19_coordinate_transfer α hα hsum l (c l)
    _ = ∑ g : Fin 210, ∑ l : Fin 3,
        c l (simplex19Index g l) * simplex19Weight α g := Finset.sum_comm
    _ = _ := by simp only [Finset.sum_mul]

/-- The same coefficient sequence on all three coordinates, as in N_triangle. -/
theorem simplex19_separable_sum (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) (c : Fin 20 → ℝ) :
    (∑ l : Fin 3, ∑ j : Fin 20,
      c j * bernstein 19 j (simplex19Point α hα hsum l)) =
        ∑ g : Fin 210, (∑ l : Fin 3, c (simplex19Index g l)) *
          simplex19Weight α g :=
  simplex19_separable_transfer α hα hsum (fun _ => c)

/-- The printed simplex monomial coefficient formula for a monomial supported
on one coordinate, obtained from marginality and interval reconstruction. -/
theorem simplex19_monomial (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) (l : Fin 3) (q : ℕ) (hq : q ≤ 19) :
    (∑ g : Fin 210, ((Nat.choose (simplex19Index g l).val q : ℝ) /
      (Nat.choose 19 q : ℝ)) * simplex19Weight α g) = α l ^ q := by
  calc
    _ = ∑ j : Fin 20, ((Nat.choose j.val q : ℝ) / (Nat.choose 19 q : ℝ)) *
        bernstein 19 j (simplex19Point α hα hsum l) :=
      (simplex19_coordinate_transfer α hα hsum l
        (fun j => (Nat.choose j.val q : ℝ) / (Nat.choose 19 q : ℝ))).symm
    _ = α l ^ q := bernstein_monomial 19 q hq (simplex19Point α hα hsum l)

/-- A uniform coefficient lower bound remains a lower bound after interpolation. -/
theorem le_simplex19 (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) (c : Fin 210 → ℝ) (ε : ℝ)
    (hc : ∀ g, ε ≤ c g) : ε ≤ ∑ g : Fin 210, c g * simplex19Weight α g := by
  have heq : (∑ g : Fin 210, ε * simplex19Weight α g) = ε := by
    rw [← Finset.mul_sum, simplex19_probability α hα hsum, mul_one]
  rw [← heq]
  apply Finset.sum_le_sum
  intro g _
  exact mul_le_mul_of_nonneg_right (hc g) (simplex19Weight_nonneg α hα g)

theorem simplex19_pos (α : Fin 3 → ℝ) (hα : ∀ l, 0 ≤ α l)
    (hsum : ∑ l : Fin 3, α l = 1) (c : Fin 210 → ℝ) (ε : ℝ)
    (hε : 0 < ε) (hc : ∀ g, ε ≤ c g) :
    0 < ∑ g : Fin 210, c g * simplex19Weight α g :=
  lt_of_lt_of_le hε (le_simplex19 α hα hsum c ε hc)

end CGLMPBounds.Certificates
