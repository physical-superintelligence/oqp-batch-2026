@article{Costa:aa,
	Abstract = {We consider the Regge limit of the CFT correlation functions \langle {\cal J} {\cal J} {\cal O}{\cal O}\rangle \langle {\cal J} {\cal J} {\cal O}{\cal O}\rangle and \langle TT {\cal O}{\cal O}\rangle \langle TT {\cal O}{\cal O}\rangle , where {\cal J} {\cal J} is a vector current, T T is the stress tensor and {\cal O} {\cal O} is some scalar operator. These correlation functions are related by a type of Fourier transform to the AdS phase shift of the dual 2-to-2 scattering process. AdS unitarity was conjectured some time ago to be positivity of the imaginary part of this bulk phase shift. This condition was recently proved using purely CFT arguments. For large N N CFTs we further expand on these ideas, by considering the phase shift in the Regge limit, which is dominated by the leading Regge pole with spin j(ν) j(ν) , where ν ν is a spectral parameter. We compute the phase shift as a function of the bulk impact parameter, and then use AdS unitarity to impose bounds on the analytically continued OPE coefficients C_{{\cal J}{\cal J}j(ν)} C_{{\cal J}{\cal J}j(ν)} and C_{TTj(ν)} C_{TTj(ν)} that describe the coupling to the leading Regge trajectory of the current {\cal J} {\cal J} and stress tensor T T . AdS unitarity implies that the OPE coefficients associated to non-minimal couplings of the bulk theory vanish at the intercept value ν=0 ν=0 , for any CFT. Focusing on the case of large gap theories, this result can be used to show that the physical OPE coefficients C_{{\cal J}{\cal J}T} C_{{\cal J}{\cal J}T} and C_{TTT} C_{TTT} , associated to non-minimal bulk couplings, scale with the gap Δ_g Δ_g as Δ_g^{-2} Δ_g^{-2} or Δ_g^{-4} Δ_g^{-4} . Also, looking directly at the unitarity condition imposed at the OPE coefficients C_{{\cal J}{\cal J}T} C_{{\cal J}{\cal J}T} and C_{TTT} C_{TTT} results precisely in the known conformal collider bounds , giving a new CFT derivation of these bounds . We finish with remarks on finite N N theories and show directly in the CFT that the spin function j(ν) j(ν) is convex, extending this property to the continuation to complex spin.},
	Author = {Miguel S. Costa and Tobias Hansen and Jo{\~a}o Penedones},
	Date-Added = {2019-04-29 12:58:33 -0700},
	Date-Modified = {2019-04-29 12:58:33 -0700},
	Title = {Bounds for OPE coefficients on the Regge trajectory}}

